---
import '../styles/global.css';
import { SITE_URL, cleanPageTitle, getBreadcrumbs, getPageType, getServiceDefinition } from '../data/seo.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  article?: {
    datePublished: string;
  };
}

const {
  title = 'Arkansas Property Buyers — Fair Cash Offers for Arkansas Homes',
  description = 'Arkansas Property Buyers is a family-owned home buyer based in Little Rock, serving Central Arkansas and surrounding communities. We buy houses as-is with no repairs, clean-outs, showings, or agent commissions.',
  image = '/images/apb-team.jpg',
  noindex = false,
  article = null,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const canonicalHref = canonicalURL.href;
const ogImage = new URL(image, Astro.site);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const businessId = `${SITE_URL}/#business`;
const websiteId = `${SITE_URL}/#website`;
const webpageId = `${canonicalHref}#webpage`;
const breadcrumbId = `${canonicalHref}#breadcrumb`;
const serviceId = `${canonicalHref}#service`;
const articleId = `${canonicalHref}#article`;

const pageName = cleanPageTitle(title);
const breadcrumbs = getBreadcrumbs(Astro.url.pathname, pageName);
const serviceDefinition = getServiceDefinition(Astro.url.pathname);
const pageType = getPageType(Astro.url.pathname);

const serviceArea = [
  {
    '@type': 'City',
    name: 'Little Rock',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'AR',
      addressCountry: 'US',
    },
  },
  {
    '@type': 'Place',
    name: 'Central Arkansas and surrounding communities',
    description: 'Areas within approximately two hours of Little Rock, Arkansas.',
  },
];

const businessEntity = {
  '@type': ['LocalBusiness', 'Organization'],
  '@id': businessId,
  name: 'Arkansas Property Buyers',
  legalName: 'Arkansas Property Buyers LLC',
  url: `${SITE_URL}/`,
  telephone: '+1-501-504-7109',
  description: 'Arkansas Property Buyers is a family-owned home buying company based in Little Rock, Arkansas. We buy houses directly and as-is for cash, without repairs, clean-outs, showings, or agent commissions.',
  image: `${SITE_URL}/images/apbteam.png`,
  logo: `${SITE_URL}/images/apb-icon.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2024 Arkansas Valley Dr., Ste 407',
    addressLocality: 'Little Rock',
    addressRegion: 'AR',
    postalCode: '72212',
    addressCountry: 'US',
  },
  areaServed: serviceArea,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'https://schema.org/Monday',
      'https://schema.org/Tuesday',
      'https://schema.org/Wednesday',
      'https://schema.org/Thursday',
      'https://schema.org/Friday',
      'https://schema.org/Saturday',
    ],
    opens: '08:00',
    closes: '19:00',
  },
  sameAs: [
    'https://www.facebook.com/propertybuyersar/',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-501-504-7109',
    contactType: 'customer service',
    availableLanguage: 'English',
  },
};

const websiteEntity = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${SITE_URL}/`,
  name: 'Arkansas Property Buyers',
  publisher: {
    '@id': businessId,
  },
  inLanguage: 'en-US',
};

const webPageEntity: Record<string, any> = {
  '@type': pageType,
  '@id': webpageId,
  url: canonicalHref,
  name: pageName || title,
  description,
  isPartOf: {
    '@id': websiteId,
  },
  publisher: {
    '@id': businessId,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImage.href,
  },
  inLanguage: 'en-US',
};

if (breadcrumbs.length > 1) {
  webPageEntity.breadcrumb = {
    '@id': breadcrumbId,
  };
}

if (serviceDefinition) {
  webPageEntity.mainEntity = {
    '@id': serviceId,
  };
}

if (article) {
  webPageEntity.mainEntity = {
    '@id': articleId,
  };
}

const graph: Record<string, any>[] = [businessEntity, websiteEntity, webPageEntity];

if (breadcrumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': breadcrumbId,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.path, SITE_URL).href,
    })),
  });
}

if (serviceDefinition) {
  graph.push({
    '@type': 'Service',
    '@id': serviceId,
    name: serviceDefinition.name,
    serviceType: serviceDefinition.serviceType,
    description: serviceDefinition.description,
    url: canonicalHref,
    provider: {
      '@id': businessId,
    },
    areaServed: serviceArea,
  });
}

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    '@id': articleId,
    headline: pageName || title,
    description,
    image: ogImage.href,
    datePublished: article.datePublished,
    author: {
      '@id': businessId,
    },
    publisher: {
      '@id': businessId,
    },
    mainEntityOfPage: {
      '@id': webpageId,
    },
    isPartOf: {
      '@id': websiteId,
    },
    inLanguage: 'en-US',
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-S2PVGKQCYR"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-S2PVGKQCYR');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Arkansas Property Buyers">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@1,500;1,600&family=Lato:wght@400;700&family=Montserrat:wght@600;700&family=Roboto+Condensed:wght@700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@1,500;1,600&family=Lato:wght@400;700&family=Montserrat:wght@600;700&family=Roboto+Condensed:wght@700&display=swap"></noscript>
</head>
<body>
  <slot />
  <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a568ff682c5a91e7f78480e" data-source="WEB_USER"></script>
  <script src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_0185c75748734d2499d33b8bc1006fdf"></script>
  <script is:inline>
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href^="tel:"]');
      if (link && window.gtag) {
        gtag('event', 'phone_call_click', {
          phone_number: link.getAttribute('href').replace('tel:', ''),
          link_text: link.textContent.trim(),
          page_path: window.location.pathname
        });
      }
    });
  </script>

  <!-- Shared anti-spam protection for every APB lead form except probate -->
  <script is:inline define:vars={{ turnstileSiteKey }}>
    (function () {
      var turnstileReady = false;

      function getSource(form) {
        var sourceField = form.querySelector('input[name="source"]');
        return sourceField ? sourceField.value : '';
      }

      function isSkippedForm(form) {
        return getSource(form) === 'probate-help';
      }

      function getStatus(form) {
        var status = form.querySelector('[data-apb-form-status]');
        if (!status) {
          status = document.createElement('p');
          status.setAttribute('data-apb-form-status', '');
          status.setAttribute('role', 'status');
          status.className = 'font-body text-xs text-grey text-center mt-3';
          form.appendChild(status);
        }
        return status;
      }

      function getThankYouUrl(source) {
        if (source === 'avoid-foreclosure') return '/thank-you/avoid-foreclosure/';
        if (source === 'contact') return '/thank-you/contact/';
        if (source === 'sell-as-is') return '/thank-you/sell-as-is/';
        if (source === 'senior-living-transition') return '/thank-you/senior-living-transition/';
        if (source === 'senior-care-help') return '/thank-you/senior-care-help/';
        return '/thank-you/sell-my-house-fast/';
      }

      function addHoneypot(form) {
        if (form.querySelector('input[name="company_website"]')) return;

        var wrapper = document.createElement('div');
        wrapper.setAttribute('aria-hidden', 'true');
        wrapper.style.position = 'absolute';
        wrapper.style.left = '-10000px';
        wrapper.style.width = '1px';
        wrapper.style.height = '1px';
        wrapper.style.overflow = 'hidden';

        var label = document.createElement('label');
        label.textContent = 'Company website';

        var input = document.createElement('input');
        input.type = 'text';
        input.name = 'company_website';
        input.tabIndex = -1;
        input.autocomplete = 'off';

        label.appendChild(input);
        wrapper.appendChild(label);
        form.appendChild(wrapper);
      }

      function renderTurnstile(form) {
        if (!turnstileReady || !window.turnstile || form.dataset.turnstileWidgetId) return;

        var container = form.querySelector('[data-apb-turnstile]');
        if (!container) {
          container = document.createElement('div');
          container.setAttribute('data-apb-turnstile', '');
          container.className = 'mt-3';
          form.appendChild(container);
        }

        if (!turnstileSiteKey) {
          getStatus(form).textContent = 'Form verification is temporarily unavailable. Please call (501) 504-7109.';
          return;
        }

        var widgetId = window.turnstile.render(container, {
          sitekey: turnstileSiteKey,
          action: 'lead_form',
          appearance: 'interaction-only',
          callback: function () {
            getStatus(form).textContent = '';
          },
          'expired-callback': function () {
            getStatus(form).textContent = 'Verification expired. Please submit again.';
          },
          'error-callback': function () {
            getStatus(form).textContent = 'We could not verify your browser. Please try again or call (501) 504-7109.';
          }
        });

        form.dataset.turnstileWidgetId = String(widgetId);
      }

      function prepareForms() {
        document.querySelectorAll('form#lead-capture-form').forEach(function (form) {
          if (isSkippedForm(form)) return;
          form.action = '/api/lead';
          addHoneypot(form);
          renderTurnstile(form);
        });
      }

      window.apbTurnstileReady = function () {
        turnstileReady = true;
        prepareForms();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', prepareForms);
      } else {
        prepareForms();
      }

      document.addEventListener('submit', async function (event) {
        var form = event.target;
        if (!(form instanceof HTMLFormElement) || form.id !== 'lead-capture-form') return;
        if (isSkippedForm(form)) return;

        // Take control before the page-specific legacy GHL handlers run.
        event.preventDefault();
        event.stopImmediatePropagation();

        var status = getStatus(form);
        var tokenField = form.querySelector('input[name="cf-turnstile-response"]');
        var token = tokenField ? tokenField.value : '';

        if (!token) {
          status.textContent = 'Please wait a moment while we verify your browser, then submit again.';
          return;
        }

        var transactional = document.getElementById('cb-sms-transactional');
        var marketing = document.getElementById('cb-sms-marketing');
        var transactionalValue = document.getElementById('sms-transactional-consent');
        var marketingValue = document.getElementById('sms-marketing-consent');

        if (transactionalValue && transactional) {
          transactionalValue.value = transactional.checked ? 'true' : 'false';
        }
        if (marketingValue && marketing) {
          marketingValue.value = marketing.checked ? 'true' : 'false';
        }

        var submitButton = form.querySelector('button[type="submit"], input[type="submit"]');
        var originalText = '';
        if (submitButton) {
          submitButton.disabled = true;
          if (submitButton.tagName === 'BUTTON') {
            originalText = submitButton.textContent;
            submitButton.textContent = 'Sending...';
          } else {
            originalText = submitButton.value;
            submitButton.value = 'Sending...';
          }
        }

        status.textContent = 'Sending your information securely...';

        try {
          var response = await fetch('/api/lead', {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });

          if (!response.ok) {
            throw new Error('Lead submission failed');
          }

          window.location.href = getThankYouUrl(getSource(form));
        } catch (error) {
          status.textContent = 'We could not send your information. Please try again or call (501) 504-7109.';
          if (submitButton) {
            submitButton.disabled = false;
            if (submitButton.tagName === 'BUTTON') {
              submitButton.textContent = originalText;
            } else {
              submitButton.value = originalText;
            }
          }
        }
      }, true);
    })();
  </script>
  <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=apbTurnstileReady&render=explicit"></script>
</body>
</html>