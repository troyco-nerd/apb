---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const rows = [
  { label: 'Commissions / Fees', agent: '6% on average is paid by you, the seller', apb: 'NONE' },
  { label: 'Who Pays Closing Costs?', agent: '2% on average is paid by you, the seller', apb: 'NONE – We pay all costs' },
  { label: 'Inspection & Financing Contingency*', agent: 'Yes, sales can fall through', apb: 'NONE' },
  { label: 'Appraisal Needed', agent: 'Yes, the sale is often subject to appraisal', apb: 'NONE – We make cash offers' },
  { label: 'Average Days Until Sold', agent: '+/- 91 Days', apb: 'IMMEDIATE CASH OFFER' },
  { label: 'Number Of Showings', agent: 'It Depends', apb: '1 (Just Us)' },
  { label: 'Closing Date', agent: '30-60 +/- days after accepting buyer’s offer', apb: 'You choose the closing date' },
  { label: 'Who Pays For Repairs?', agent: 'Negotiated during inspection period', apb: 'NONE – We pay for all repairs' },
];

const benefits = [
  {
    title: 'From Offer To Close And Cash In Your Hand In As Little As 3 Days',
    body: "You can get rid of the headache of that property fast and avoid paying any more utility, tax, insurance, or mortgage payments. If you list your house and wait 90+ days to close, you have to figure in all the costs of holding that property while you wait.",
  },
  {
    title: "Don't Worry About Fixing Anything Up Or Cleaning For Buyer After Buyer",
    body: "We don't care how dirty your house is (we've seen worse!) or how many repairs are needed – a complete fixer? Great, we love projects. We'd like to make an offer on your house as-is. This saves you time and money you can keep in your pocket.",
  },
  {
    title: "Don't Worry About Paying Closing Fees – We've Got You Covered",
    body: 'As a trusted, full-service home buyer here in Arkansas, we pay for all of the closing costs. What we offer you is what you get (minus any mortgage payoff or other encumbrances on the property).',
  },
];
---

<Layout
  title="Selling With An Agent vs. Selling To Arkansas Property Buyers"
  description="Compare selling your Arkansas house with a local agent versus selling directly to Arkansas Property Buyers LLC. See the real difference in fees, timelines, repairs, and more."
>

<!-- HEADER -->
<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/apb icon.png" alt="Arkansas Property Buyers" class="h-10 w-auto object-contain">
        <span class="font-sub font-bold text-navy text-sm tracking-tight">Arkansas Property Buyers</span>
      </a>
      <nav class="hidden md:flex items-center gap-7">
        <a href="/#how-it-works" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">How It Works</a>
        <a href="/about"        class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">About Us</a>
        <a href="/#testimonials" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Reviews</a>
        <a href="/blog"          class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Blog</a>
        <a href="tel:+15015047109" class="font-sub font-bold text-sm text-orange flex items-center gap-1.5 hover:text-gold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (501) 504-7109
        </a>
        <a href="/contact" class="bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-4 py-2 rounded transition-colors uppercase tracking-wider">Contact Us</a>
      </nav>
      <button onclick="document.getElementById('mobNav').classList.toggle('open')" class="md:hidden p-2 text-grey">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobNav" class="mob-nav md:hidden border-t border-gray-100">
      <nav class="flex flex-col py-4 gap-1">
        <a href="/#how-it-works" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">How It Works</a>
        <a href="/about"        class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">About Us</a>
        <a href="/#testimonials" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Reviews</a>
        <a href="/blog"         class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Blog</a>
        <a href="tel:+15015047109" class="py-2 px-1 font-sub font-bold text-sm text-orange">(501) 504-7109</a>
        <a href="/contact" class="mt-2 bg-orange text-white font-sub font-bold text-xs px-4 py-2.5 rounded text-center uppercase tracking-wider">Contact Us</a>
      </nav>
    </div>
  </div>
</header>

<!-- SLIM BANNER -->
<div class="bg-navy text-white px-5 py-2.5 text-center">
  <p class="font-sub font-bold text-xs uppercase tracking-wider">
    Family-owned &middot; Arkansas-based &middot; 30+ years serving homeowners &ndash;
    <a href="tel:+15015047109" class="text-orange hover:text-gold transition-colors ml-1 underline underline-offset-2">(501) 504-7109</a>
  </p>
</div>

<!-- MAIN: 2-column sticky layout -->
<div class="bg-white">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-14 sm:py-20">
    <div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-14 items-start">

      <!-- ═══ LEFT COLUMN ═══ -->
      <div>

        <!-- HERO -->
        <div class="mb-12">
          <p class="eyebrow tracking-widest mb-4">Know Your Options</p>
          <h1 class="font-display font-bold text-navy uppercase leading-tight text-3xl sm:text-4xl mb-4">Selling With A Local Agent vs. Selling To Arkansas Property Buyers</h1>
          <p class="tagline-script mb-5">See the real numbers before you decide.</p>
          <p class="font-body text-grey text-base leading-relaxed mb-4">Even in a seller's market, it's smart to look at your options and see what will actually help you reach your goals. While you may get a higher "top line" sales price listing with a local agent, that doesn't always mean more money in your pocket &mdash; or less headache.</p>
          <p class="font-body text-grey text-base leading-relaxed">Dive into the details below to compare your options.</p>

          <a href="#lead-form" class="lg:hidden inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider w-full sm:w-auto mt-6">
            Get Your No-Obligation Offer &darr;
          </a>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- COMPARISON CHART -->
        <div class="mb-12">
          <p class="eyebrow tracking-widest mb-3">Side By Side</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-6">Work The Numbers And See Which Way Helps You Get There</h2>

          <div class="border border-gray-200 rounded-xl overflow-hidden">
            <div class="grid grid-cols-2 bg-navy">
              <div class="px-4 py-4 border-r border-white/10">
                <p class="font-sub font-bold text-white/70 text-xs sm:text-sm uppercase tracking-wider">Selling w/ An Agent</p>
              </div>
              <div class="px-4 py-4 bg-orange">
                <p class="font-sub font-bold text-white text-xs sm:text-sm uppercase tracking-wider">SOLD To Arkansas Property Buyers</p>
              </div>
            </div>
            {rows.map((row, i) => (
              <div class={`grid grid-cols-1 sm:grid-cols-[repeat(2,minmax(0,1fr))] ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
                <div class="px-4 pt-3 sm:pt-4 sm:col-span-2">
                  <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider">{row.label}</p>
                </div>
                <div class="px-4 pb-3 sm:pb-4 sm:pt-1 border-r-0 sm:border-r border-gray-200">
                  <p class="font-body text-grey text-sm leading-snug">{row.agent}</p>
                </div>
                <div class="px-4 pb-3 sm:pb-4 sm:pt-1">
                  <p class="font-sub font-bold text-navy text-sm leading-snug">{row.apb}</p>
                </div>
              </div>
            ))}
          </div>
          <p class="font-body text-grey text-xs leading-relaxed mt-3">*Inspection & financing contingencies are common with traditional agent-listed sales; a buyer can back out or renegotiate after inspection or if their loan falls through.</p>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- BENEFITS -->
        <div class="mb-12">
          <p class="eyebrow tracking-widest mb-3">The Real Benefits</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-6">What This Means For You</h2>
          <p class="font-body text-grey text-base leading-relaxed mb-8">When you really work the numbers, you start to see the real benefits each way of selling your Arkansas house offers. Here at Arkansas Property Buyers, we work to solve your problems and offer you a fair price &mdash; plus benefits the traditional sale route just can't offer.</p>

          <div class="flex flex-col gap-6">
            {benefits.map((b) => (
              <div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-2">{b.title}</h3>
                <p class="font-body text-grey text-sm leading-relaxed">{b.body}</p>
              </div>
            ))}
          </div>

          <p class="font-body text-grey text-base leading-relaxed mt-8">So when you add up the time you could save, the no-hassle experience, and the money you'll save on commissions, fees, and holding costs while you wait to sell the traditional route &mdash; for many area homeowners, selling to a professional house buyer like Arkansas Property Buyers is the best viable option.</p>
          <p class="font-body text-grey text-base leading-relaxed mt-4">Is it for you? See for yourself and get a fair all-cash offer on your house today.</p>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- FINAL CTA -->
        <div class="bg-navy rounded-2xl px-7 py-9 text-center">
          <p class="eyebrow tracking-widest mb-3">What Do You Have To Lose?</p>
          <h2 class="font-display font-bold text-white uppercase text-2xl sm:text-3xl leading-tight mb-4">Get Started Now</h2>
          <p class="font-body text-white/70 text-base leading-relaxed max-w-md mx-auto mb-7">We buy houses in ANY CONDITION in Arkansas. There are no commissions or fees, and no obligation whatsoever. Just fill out the short form or give us a call &mdash; let's chat.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="tel:+15015047109" class="inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              Call (501) 504-7109
            </a>
            <a href="#lead-form" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider">
              Request My Free Offer &darr;
            </a>
          </div>
          <p class="font-body text-white/40 text-xs mt-5">No obligation. No pressure. Just honest guidance.</p>
        </div>

      </div>
      <!-- ═══ END LEFT COLUMN ═══ -->

      <!-- ═══ RIGHT COLUMN: sticky form ═══ -->
      <div id="lead-form" class="lg:sticky lg:top-24">

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
          <div class="bg-navy px-6 py-5">
            <h2 class="font-display font-bold text-white uppercase text-lg tracking-wide">Get Your No-Obligation Offer</h2>
            <p class="font-body text-white/60 text-sm mt-1">No pressure. No obligation. Just honest guidance.</p>
          </div>

          <div class="px-6 pt-5 pb-2 flex items-center gap-2">
            <div id="dot1" class="step-dot active w-7 h-7 rounded-full border-2 border-orange bg-orange text-white flex items-center justify-center font-sub font-bold text-xs flex-shrink-0">1</div>
            <div id="connector" class="flex-1 h-0.5 bg-gray-200 transition-colors duration-300"></div>
            <div id="dot2" class="step-dot w-7 h-7 rounded-full border-2 border-gray-200 flex items-center justify-center font-sub font-bold text-xs text-grey flex-shrink-0">2</div>
            <span id="step-label" class="font-body text-xs text-grey ml-1 flex-shrink-0">Step 1 of 2</span>
          </div>

          <div id="step1" class="px-6 pb-5 pt-3 fade-up">
            <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-4">Tell us who you are</p>
            <div class="flex flex-col gap-4">
              <div>
                <label for="f-name" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Your Name</label>
                <input id="f-name" type="text" placeholder="First &amp; Last Name" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
              </div>
              <div>
                <label for="f-phone" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Phone Number</label>
                <input id="f-phone" type="tel" placeholder="(501) 000-0000" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
              </div>
              <div>
                <label for="f-email" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Email Address</label>
                <input id="f-email" type="email" placeholder="you@example.com" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
              </div>
              <button type="button" onclick="goToStep2()" class="w-full bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider mt-1">
                Next: Property Address &rarr;
              </button>
            </div>
            <p class="font-body text-xs text-grey text-center mt-3">Confidential &middot; no obligation &middot; no pressure</p>
          </div>

          <!-- GoHighLevel: paste your webhook URL in the action attribute below -->
          <div id="step2" class="px-6 pb-5 pt-3 hidden">
            <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-4">Tell us about the property</p>
            <form id="lead-capture-form" action="https://services.leadconnectorhq.com/hooks/kqj3LlvP9g5EoyEpo1w2/webhook-trigger/1cb96243-342a-4468-8ff6-482d4f5bda73" method="POST">
              <input type="hidden" id="sf-name" name="firstName" value="">
              <input type="hidden" id="sf-phone" name="phone" value="">
              <input type="hidden" id="sf-email" name="email" value="">
              <input type="hidden" name="source" value="compare">
              <input type="hidden" name="lead_source" value="Organic Website">
              <input type="hidden" name="lead_type" value="General Seller">
              <input type="hidden" name="pipeline_category" value="Seller Lead">
              <div class="flex flex-col gap-4">
                <div>
                  <label for="f-street" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Street Address</label>
                  <input id="f-street" type="text" name="address1" placeholder="123 Main St" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="f-city" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">City</label>
                    <input id="f-city" type="text" name="city" placeholder="Little Rock" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
                  </div>
                  <div>
                    <label for="f-zip" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Zip Code</label>
                    <input id="f-zip" type="text" name="postalCode" placeholder="72201" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
                  </div>
                </div>
                <div class="flex gap-2 mt-1">
                  <button type="button" onclick="goToStep1()" class="w-1/3 border border-gray-200 text-grey font-sub font-bold text-xs px-4 py-3.5 rounded hover:border-navy hover:text-navy transition-colors">&larr; Back</button>
                  <button type="submit" class="flex-1 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider">Request Offer</button>
                </div>
              </div>
            </form>
            <p class="font-body text-xs text-grey text-center mt-3">We'll follow up within 24 hours &middot; no pressure</p>
          </div>

          <div class="px-6 pb-5 pt-1 border-t border-gray-100">
            <a href="tel:+15015047109" class="inline-flex items-center justify-center gap-2 bg-navy hover:bg-orange text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider w-full">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              Or Call (501) 504-7109
            </a>
          </div>
        </div>

        <div class="mt-4 bg-gray-50 border border-gray-100 rounded-xl px-5 py-4">
          <div class="flex items-center gap-2 mb-2">
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <span class="font-sub font-bold text-navy text-xs">30+ years helping Arkansas families</span>
          </div>
          <p class="font-body text-grey text-xs leading-relaxed italic">"Just wanted to let you know it was a great pleasure doing business with you. You made everything so easy for us."</p>
          <p class="font-sub font-bold text-navy text-xs mt-1.5">&ndash; Allen C., Arkansas Homeowner</p>
        </div>

        <div class="mt-4 grid grid-cols-3 gap-2 text-center">
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">No Obligation</p>
          </div>
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">Confidential</p>
          </div>
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">Local Arkansas</p>
          </div>
        </div>

      </div>
      <!-- ═══ END RIGHT COLUMN ═══ -->

    </div>
  </div>
</div>

<Footer />

<!-- MOBILE STICKY BAR -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-4 py-3 flex gap-3 z-40">
  <a href="tel:+15015047109" class="flex-1 inline-flex items-center justify-center gap-2 bg-navy text-white font-sub font-bold text-xs px-4 py-3 rounded uppercase tracking-wider">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    Call Now
  </a>
  <a href="#lead-form" class="flex-1 inline-flex items-center justify-center gap-2 bg-orange text-white font-sub font-bold text-xs px-4 py-3 rounded uppercase tracking-wider">
    Get My Offer
  </a>
</div>

<script>
  function goToStep2() {
    const name = document.getElementById('f-name').value.trim();
    const phone = document.getElementById('f-phone').value.trim();
    const email = document.getElementById('f-email').value.trim();
    if (!name || !phone || !email) { alert('Please enter your name, phone number, and email to continue.'); return; }
    document.getElementById('sf-name').value = name;
    document.getElementById('sf-phone').value = phone;
    document.getElementById('sf-email').value = email;
    document.getElementById('step1').classList.add('hidden');
    document.getElementById('step2').classList.remove('hidden');
    document.getElementById('step2').classList.add('fade-up');
    document.getElementById('dot1').className = 'step-dot done w-7 h-7 rounded-full border-2 border-navy bg-navy text-white flex items-center justify-center font-sub font-bold text-xs flex-shrink-0';
    document.getElementById('dot2').className = 'step-dot active w-7 h-7 rounded-full border-2 border-orange bg-orange text-white flex items-center justify-center font-sub font-bold text-xs flex-shrink-0';
    document.getElementById('connector').classList.add('bg-orange');
    document.getElementById('step-label').textContent = 'Step 2 of 2';
  }
  function goToStep1() {
    document.getElementById('step2').classList.add('hidden');
    document.getElementById('step1').classList.remove('hidden');
    document.getElementById('dot1').className = 'step-dot active w-7 h-7 rounded-full border-2 border-orange bg-orange text-white flex items-center justify-center font-sub font-bold text-xs flex-shrink-0';
    document.getElementById('dot2').className = 'step-dot w-7 h-7 rounded-full border-2 border-gray-200 flex items-center justify-center font-sub font-bold text-xs text-grey flex-shrink-0';
    document.getElementById('connector').classList.remove('bg-orange');
    document.getElementById('step-label').textContent = 'Step 1 of 2';
  }

  document.getElementById('lead-capture-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.target;
    fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' })
      .finally(() => { window.location.href = '/thank-you/sell-my-house-fast/'; });
  });
</script>

</Layout>
