---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | Arkansas Property Buyers`}
  description={post.data.description}
  image={post.data.featuredImage}
>

<!-- HEADER -->
<Header active="blog" />

<!-- ARTICLE HERO -->
<section class="bg-white border-b border-gray-100 pt-12 pb-10">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <a href="/blog" class="inline-flex items-center gap-1.5 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-orange transition-colors mb-6">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
      All Articles
    </a>
    <p class="font-sub font-bold text-xs text-orange uppercase tracking-wider mb-3">{formattedDate}</p>
    <h1 class="font-display font-bold text-navy uppercase leading-tight text-3xl sm:text-4xl mb-4">{post.data.title}</h1>
    {post.data.description && (
      <p class="font-body text-grey text-base leading-relaxed">{post.data.description}</p>
    )}
  </div>
</section>

<!-- FEATURED IMAGE -->
{post.data.featuredImage && (
  <div class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 py-8">
      <img
        src={post.data.featuredImage}
        alt={post.data.title}
        class="w-full rounded-xl shadow-sm"
        loading="eager"
      />
    </div>
  </div>
)}

<!-- ARTICLE BODY -->
<article class="bg-white py-12 sm:py-16">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="prose prose-slate max-w-none
      prose-headings:font-display prose-headings:font-bold prose-headings:text-navy prose-headings:uppercase prose-headings:leading-tight
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
      prose-p:font-body prose-p:text-grey prose-p:leading-relaxed prose-p:text-base
      prose-a:text-orange prose-a:no-underline hover:prose-a:text-gold
      prose-strong:text-navy prose-strong:font-bold
      prose-ul:font-body prose-ul:text-grey prose-ul:text-base
      prose-ol:font-body prose-ol:text-grey prose-ol:text-base
      prose-li:leading-relaxed
      prose-img:rounded-xl prose-img:shadow-sm
      prose-hr:border-gray-100">
      <Content />
    </div>
  </div>
</article>

<!-- CTA BANNER -->
<section class="bg-navy py-14">
  <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Have Questions About Your Situation?</p>
    <h2 class="font-display font-bold text-white uppercase text-2xl sm:text-3xl leading-tight mb-4">Let's Talk. No Pressure, No Obligation.</h2>
    <p class="font-body text-white/70 text-base leading-relaxed max-w-lg mx-auto mb-8">Our family-owned Arkansas team is here to help you understand your options and make the best decision for your situation.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="tel:+15015047109" class="inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Call (501) 504-7109
      </a>
      <a href="/contact-us" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider">
        Send Us a Message &rarr;
      </a>
    </div>
  </div>
</section>

<Footer />

</Layout>
