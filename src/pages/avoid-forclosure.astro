---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header class="bg-white border-b border-gray-100 py-4">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 flex justify-between items-center">
      <a href="/" class="flex items-center gap-2">
        <img src="/images/your-logo.png" alt="Arkansas Property Buyers" class="h-8 w-auto object-contain">
      </a>
      <a href="tel:+15015551234" class="font-sub font-bold text-sm text-orange hover:text-gold">(501) 555-1234</a>
    </div>
  </header>

  <section class="bg-gray-50 py-16 sm:py-24 border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 items-center">
      
      <div>
        <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Local Pope County Assistance</p>
        <h1 class="font-display font-bold text-navy uppercase text-4xl sm:text-5xl leading-tight mb-4">Stop the Auction.<br>Protect Your Equity.</h1>
        <p class="font-body text-grey text-lg mb-6 leading-relaxed">If you've received a notice of default or an auction date is approaching, you still have options. We buy houses fast for cash, helping you avoid a foreclosure on your record.</p>
        
        <ul class="space-y-3 font-sub text-sm text-navy font-bold">
          <li class="flex items-center gap-2">
            <span class="text-orange text-lg">✓</span> No repairs or cleanout required
          </li>
          <li class="flex items-center gap-2">
            <span class="text-orange text-lg">✓</span> We can close before your auction date
          </li>
          <li class="flex items-center gap-2">
            <span class="text-orange text-lg">✓</span> No agent commissions or hidden fees
          </li>
        </ul>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="bg-navy px-6 py-5">
          <h2 class="font-display font-bold text-white uppercase text-lg tracking-wide">Get Your Fair Cash Offer</h2>
          <p class="font-body text-white/60 text-sm mt-1">Fill out the form below or call us directly.</p>
        </div>
        <div class="p-6">
          <p class="text-center text-gray-400 font-body text-sm py-10">[ Salesforce Form Goes Here ]</p>
        </div>
      </div>

    </div>
  </section>
</Layout>