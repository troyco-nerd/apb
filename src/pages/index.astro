---
import Layout from '../layouts/Layout.astro';
---

<Layout>
<!-- HEADER -->
<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="#" class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/apb icon.png" alt="Arkansas Property Buyers" class="h-10 w-auto object-contain">
        <span class="font-sub font-bold text-navy text-sm tracking-tight">Arkansas Property Buyers</span>
      </a>
      <nav class="hidden md:flex items-center gap-7">
        <a href="#how-it-works" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">How It Works</a>
        <a href="#about"        class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">About Us</a>
        <a href="#testimonials" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Reviews</a>
        <a href="tel:+15015551234" class="font-sub font-bold text-sm text-orange flex items-center gap-1.5 hover:text-gold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (501) 555-1234
        </a>
        <a href="#offer-tool" class="bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-4 py-2 rounded transition-colors uppercase tracking-wider">Get My Offer</a>
      </nav>
      <button onclick="document.getElementById('mobNav').classList.toggle('open')" class="md:hidden p-2 text-grey">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobNav" class="mob-nav md:hidden border-t border-gray-100">
      <nav class="flex flex-col py-4 gap-1">
        <a href="#how-it-works" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">How It Works</a>
        <a href="#about"        class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">About Us</a>
        <a href="#testimonials" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Reviews</a>
        <a href="tel:+15015551234" class="py-2 px-1 font-sub font-bold text-sm text-orange">(501) 555-1234</a>
        <a href="#offer-tool" class="mt-2 bg-orange text-white font-sub font-bold text-xs px-4 py-2.5 rounded text-center uppercase tracking-wider">Get My Offer</a>
      </nav>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="bg-white pt-16 pb-20 sm:pt-20 sm:pb-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-[1fr_420px] gap-12 lg:gap-16 items-start">
      <div class="pt-1 lg:pt-4">
        <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-4">Locally Owned &amp; Operated in Arkansas</p>
        <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-3">Get a Fair Cash Offer for Your Arkansas Property</h1>
        <p class="font-script text-orange text-xl mb-6">You have options — let's talk.</p>
        <p class="font-body text-grey text-base leading-relaxed mb-8 max-w-md">No agent fees. No repair costs. No drawn-out closing. We buy houses across Arkansas and handle everything so you don't have to.</p>
        <div class="flex flex-col gap-5 mb-10">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-sub font-bold text-navy text-sm">Close in as Few as 3 Days</p>
              <p class="font-body text-grey text-sm">You pick the timeline that works for you.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <p class="font-sub font-bold text-navy text-sm">Zero Fees or Commissions</p>
              <p class="font-body text-grey text-sm">What we offer is what you keep.</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-3 text-sm text-grey font-body border-t border-gray-100 pt-6">
          <svg class="w-4 h-4 text-navy flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Serving all of Arkansas — Little Rock · Fort Smith · Fayetteville · Jonesboro · Russellville &amp; more</span>
        </div>
      </div>
    <div id="offer-tool" class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
        
        <div class="bg-navy px-6 py-5">
          <h2 class="font-display font-bold text-white uppercase text-lg tracking-wide">How can we help you today?</h2>
          <p class="font-body text-white/60 text-sm mt-1">Select your situation to see your options.</p>
        </div>

        <div class="px-6 pb-6 pt-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="/avoid-foreclosure" class="group block border border-gray-200 rounded-lg p-5 text-center transition-all hover:border-orange hover:bg-orange/5 hover:shadow-md cursor-pointer">
              <span class="block text-3xl mb-3 group-hover:scale-110 transition-transform">📋</span>
              <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide group-hover:text-orange transition-colors">Avoid Foreclosure</h3>
            </a>
            
            <a 
            href="https://myarkansasprobate.com/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group block border border-gray-200 rounded-lg p-5 text-center transition-all hover:border-orange hover:bg-orange/5 hover:shadow-md cursor-pointer"
          >
            <span class="block text-3xl mb-3 group-hover:scale-110 transition-transform">⚖️</span>
            <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide group-hover:text-orange transition-colors">
              Probate Help
            </h3>
          </a>
            
            <a href="/senior-living-transition" class="group block border border-gray-200 rounded-lg p-5 text-center transition-all hover:border-orange hover:bg-orange/5 hover:shadow-md cursor-pointer">
              <span class="block text-3xl mb-3 group-hover:scale-110 transition-transform">📦</span>
              <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide group-hover:text-orange transition-colors">Senior Living Transition</h3>
            </a>
            
            <a href="/sell-as-is" class="group block border border-gray-200 rounded-lg p-5 text-center transition-all hover:border-orange hover:bg-orange/5 hover:shadow-md cursor-pointer">
              <span class="block text-3xl mb-3 group-hover:scale-110 transition-transform">🔧</span>
              <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide group-hover:text-orange transition-colors">Sell My House As-Is</h3>
            </a>
          </div>
          
          <div class="mt-6 pt-6 border-t border-gray-100 text-center">
            <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-3">Need immediate assistance?</p>
            <a href="tel:+15015551234" class="inline-flex items-center justify-center gap-2 bg-navy hover:bg-orange text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider w-full">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              Call (501) 555-1234
            </a>
          </div>
        </div>
      </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="bg-white py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="mb-12">
      <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Why Homeowners Choose Us</p>
      <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight max-w-md">The Advantages Are Clear</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">Local Arkansas Buyer</h3>
        <p class="font-body text-grey text-sm leading-relaxed">We live and work here. You'll deal with a real team based right here in Arkansas — not an out-of-state call center.</p>
      </div>
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">No Fees or Commissions</h3>
        <p class="font-body text-grey text-sm leading-relaxed">No agent fees, no hidden costs, no commissions. The offer you accept is the amount you receive.</p>
      </div>
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">No Repairs Needed</h3>
        <p class="font-body text-grey text-sm leading-relaxed">We buy properties in any condition — roof damage, foundation issues, you name it. Sell as-is.</p>
      </div>
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">Choose Your Closing Date</h3>
        <p class="font-body text-grey text-sm leading-relaxed">Close in two weeks or two months — whatever timeline works for you. You're in control.</p>
      </div>
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">Fair Cash Offers</h3>
        <p class="font-body text-grey text-sm leading-relaxed">We evaluate every property individually and present a transparent, honest offer. No lowball games.</p>
      </div>
      <div class="lift">
        <div class="w-10 h-10 bg-navy rounded-full flex items-center justify-center mb-4"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">We Pay Closing Costs</h3>
        <p class="font-body text-grey text-sm leading-relaxed">We cover all closing costs so there are no surprises. What you're offered is what you walk away with.</p>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="bg-gray-50 py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-14">
      <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Simple Process</p>
      <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight">Three Simple Steps</h2>
      <p class="font-body text-grey mt-3 text-base max-w-sm mx-auto">From first contact to closing — here's how it works.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-12 h-12 bg-navy text-white rounded-full flex items-center justify-center mx-auto mb-5 font-display font-bold text-xl">1</div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-2">Tell Us About the Property</h3>
        <p class="font-body text-grey text-sm leading-relaxed">Use the form above or give us a call. Share a few details about the property and your situation. It takes about a minute.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-navy text-white rounded-full flex items-center justify-center mx-auto mb-5 font-display font-bold text-xl">2</div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-2">Review Your Cash Offer</h3>
        <p class="font-body text-grey text-sm leading-relaxed">We'll evaluate the property and present a fair, no-obligation cash offer — usually within 24 hours.</p>
      </div>
      <div class="text-center">
        <div class="w-12 h-12 bg-navy text-white rounded-full flex items-center justify-center mx-auto mb-5 font-display font-bold text-xl">3</div>
        <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-2">Close on Your Timeline</h3>
        <p class="font-body text-grey text-sm leading-relaxed">Accept the offer and pick a closing date. We handle the paperwork and pay all closing costs.</p>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="bg-white py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="rounded-xl overflow-hidden border border-gray-100">
        <img src="images/apbteam.jpg" alt="Arkansas Property Buyers team" class="w-full object-cover aspect-[4/3]">
      </div>
      <div>
        <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">About Our Team</p>
        <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight mb-3">A Real Local Team.<br>Not a Faceless Corporation.</h2>
        <p class="font-script text-orange text-xl mb-5">We're your neighbors.</p>
        <p class="font-body text-grey leading-relaxed mb-4 text-sm">We're an Arkansas-based property buying company. When you work with us, you're working directly with our team — people who know the local market, understand the neighborhoods, and care about doing right by our neighbors.</p>
        <p class="font-body text-grey leading-relaxed mb-7 text-sm">We've helped homeowners across the state move on from properties that were weighing them down — whether it's an inherited home, a property in need of major repair, or just a house that's time to let go of.</p>
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center gap-2.5 text-sm font-sub font-bold text-navy">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Arkansas-based
          </div>
          <div class="flex items-center gap-2.5 text-sm font-sub font-bold text-navy">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            BBB Accredited
          </div>
          <div class="flex items-center gap-2.5 text-sm font-sub font-bold text-navy">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            100+ Homes Purchased
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section id="testimonials" class="bg-gray-50 py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12">
      <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Client Stories</p>
      <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight">What Our Clients Say</h2>
      <p class="font-body text-grey mt-3 text-sm">Real experiences from Arkansas homeowners we've worked with.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-gray-100 rounded-xl p-7">
        <div class="flex gap-0.5 mb-4">
          <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
