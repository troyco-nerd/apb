---
import Layout from '../layouts/Layout.astro';
import { cities } from '../data/cities.js';

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
---

<Layout
  title={city.metaTitle}
  description={city.metaDescription}
>

<!-- HEADER -->
<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/apb icon.png" alt="Arkansas Property Buyers" class="h-10 w-auto object-contain">
        <span class="font-sub font-bold text-navy text-sm tracking-tight">Arkansas Property Buyers</span>
      </a>
      <nav class="hidden md:flex items-center gap-7">
        <a href="/#how-it-works" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">How It Works</a>
        <a href="/about"         class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">About Us</a>
        <a href="/#testimonials" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Reviews</a>
        <a href="/blog"          class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Blog</a>
        <a href="tel:+15015047109" class="font-sub font-bold text-sm text-orange flex items-center gap-1.5 hover:text-gold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (501) 504-7109
        </a>
        <a href="/contact" class="bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-4 py-2 rounded transition-colors uppercase tracking-wider">Contact Us</a>
      </nav>
      <button onclick="document.getElementById('mobNav').classList.toggle('open')" class="md:hidden p-2 text-grey">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobNav" class="mob-nav md:hidden border-t border-gray-100">
      <nav class="flex flex-col py-4 gap-1">
        <a href="/#how-it-works" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">How It Works</a>
        <a href="/about"         class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">About Us</a>
        <a href="/#testimonials" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Reviews</a>
        <a href="/blog"         class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Blog</a>
        <a href="tel:+15015047109" class="py-2 px-1 font-sub font-bold text-sm text-orange">(501) 504-7109</a>
        <a href="/contact" class="mt-2 bg-orange text-white font-sub font-bold text-xs px-4 py-2.5 rounded text-center uppercase tracking-wider">Contact Us</a>
      </nav>
    </div>
  </div>
</header>

<!-- SLIM BANNER -->
<div class="bg-navy text-white px-5 py-2.5 text-center">
  <p class="font-sub font-bold text-xs uppercase tracking-wider">
    Family-owned &middot; Arkansas-based &middot; 30+ years serving homeowners &ndash;
    <a href="tel:+15015047109" class="text-orange hover:text-gold transition-colors ml-1 underline underline-offset-2">(501) 504-7109</a>
  </p>
</div>

<!-- MAIN: 2-column sticky layout -->
<div class="bg-white">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-14 sm:py-20">
    <div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-14 items-start">

      <!-- ═══ LEFT COLUMN ═══ -->
      <div>

        <!-- HERO -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-4">Cash Home Buyers &bull; {city.county} &bull; Arkansas</p>
          <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-4">Sell Your House Fast In {city.name}, Arkansas</h1>
          <p class="font-script text-orange text-xl mb-5">Real people. Honest answers. Right here in Arkansas.</p>
          <p class="font-body text-grey text-base leading-relaxed mb-4">{city.heroSupport}</p>
          <p class="font-body text-grey text-base leading-relaxed mb-6">Whether your home needs repairs, you're facing a difficult situation, or you simply want to avoid the traditional selling process, we're here to help you understand your options and move forward with confidence.</p>

          <div class="flex flex-wrap gap-x-6 gap-y-2 mb-8">
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              No repairs or cleaning required
            </div>
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              No pressure or obligation
            </div>
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Local Arkansas family, not a national company
            </div>
          </div>

          <a href="#lead-form" class="lg:hidden inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider w-full sm:w-auto">
            Get Your No-Obligation Offer &darr;
          </a>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- TRUST SECTION -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Our Approach</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-5">Many Homeowners Aren't Looking For A Buyer. They're Looking For Answers.</h2>
          <p class="font-body text-grey text-base leading-relaxed mb-4">Many people who contact Arkansas Property Buyers simply want to understand their options. There's no pressure to sell, and no expectation that our conversation leads anywhere other than giving you a clearer picture of where things stand.</p>
          <p class="font-body text-grey text-base leading-relaxed">Sometimes selling directly to us is the best solution. Sometimes another approach makes more sense – and when that's the case, we'll say so. Our goal is to give you honest guidance so you can make the decision that's right for your family.</p>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- WHY HOMEOWNERS CONTACT US -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Common Situations</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-6">Why {city.name} Homeowners Contact Us</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Home Needs Repairs</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Avoid the cost and stress of renovations. We buy homes in any condition, as-is.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Inherited Property</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Managing an estate can be overwhelming. We help simplify the process so you can move forward.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Foreclosure Concerns</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Falling behind on payments? Understanding your options early can make a real difference.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Downsizing</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Ready for a smaller home or a simpler life? We make the transition as easy as possible.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Relocation</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Moving for work or family? Sell on your timeline without waiting for the right buyer.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Rental Property Problems</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Difficult tenants or a property that's more burden than benefit? We can help.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-xl p-5 sm:col-span-2">
              <div class="w-9 h-9 bg-orange/10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              <div>
                <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">Life Changes</h3>
                <p class="font-body text-grey text-sm leading-relaxed">Divorce, job changes, health concerns, and unexpected situations happen to everyone. When your circumstances change, we're here to help you understand your real estate options – without pressure and without judgment.</p>
              </div>
            </div>
          </div>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- SELL AS-IS -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">No Repairs. No Hassle.</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-5">Sell Your {city.name} House As-Is</h2>
          <p class="font-body text-grey text-base leading-relaxed mb-6">When you sell to Arkansas Property Buyers, you sell the property exactly as it is today. No contractor estimates. No cleaning crews. No open house weekends. Just a straightforward process that works on your schedule.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              'No repairs required',
              'No cleaning or staging',
              'No contractor delays',
              'No open houses or showings',
              'No realtor commissions',
              'No hidden fees or surprises',
            ].map((item) => (
              <div class="flex items-center gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3">
                <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <p class="font-body text-grey text-sm">{item}</p>
              </div>
            ))}
          </div>
          <p class="font-body text-grey text-sm leading-relaxed mt-5">Families can take what they want and leave the rest. We handle everything from there.</p>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- WHY CHOOSE APB -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">The APB Difference</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-6">Why Choose Arkansas Property Buyers</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {[
              { title: 'Family-Owned Arkansas Company', body: 'We\'re not a national investment firm. We\'re an Arkansas family that has been serving Arkansas homeowners for over 30 years.' },
              { title: 'More Than 30 Years Of Experience', body: 'Decades of experience means we\'ve seen it all – and we can help you find a workable solution no matter how complicated your situation may seem.' },
              { title: 'Local Knowledge', body: 'We know ' + city.name + ', ' + city.county + ', and Central Arkansas. That local familiarity means faster decisions and more relevant guidance.' },
              { title: 'Honest Conversations', body: 'We\'ll never push you toward a decision that isn\'t right for you. If another option serves you better, we\'ll tell you.' },
              { title: 'No Pressure', body: 'There are no deadlines, no hard closes, and no aggressive follow-up. You make the decision on your own timeline.' },
              { title: 'Win-Win Outcomes', body: 'We structure every transaction to work for both sides. A fair outcome for your family is the only kind that matters to us.' },
            ].map((item) => (
              <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-xl p-5">
                <div class="w-5 h-5 bg-orange rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                  <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1">{item.title}</h3>
                  <p class="font-body text-grey text-sm leading-relaxed">{item.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- PROCESS -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">How It Works</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-8">A Simple Process</h2>
          <div class="flex flex-col gap-6">
            {[
              { n: '1', title: 'Tell Us About Your Property', body: 'Fill out the short form or give us a call. We\'ll ask a few questions to understand your property and your situation.' },
              { n: '2', title: 'Discuss Your Situation And Options', body: 'We listen first. Once we understand what\'s going on, we walk through all available options – including ones that don\'t involve selling to us.' },
              { n: '3', title: 'Receive An Offer If Selling Makes Sense', body: 'If a cash sale is the right path, we\'ll present a clear, no-obligation offer with a full explanation of how we arrived at it.' },
              { n: '4', title: 'Choose A Timeline That Works For You', body: 'We close when you\'re ready. Whether that\'s two weeks or two months, we work around your schedule.' },
            ].map((step) => (
              <div class="flex gap-5">
                <div class="w-10 h-10 bg-orange rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="font-sub font-bold text-white text-sm">{step.n}</span>
                </div>
                <div class="pt-1">
                  <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-1.5">{step.title}</h3>
                  <p class="font-body text-grey text-sm leading-relaxed">{step.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- LOCAL CONNECTION -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Local Knowledge</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-5">Helping {city.name} Homeowners</h2>
          <p class="font-body text-grey text-base leading-relaxed mb-4">{city.localIntro}</p>
          <p class="font-body text-grey text-base leading-relaxed">{city.localClosing}</p>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- TESTIMONIALS -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">What Homeowners Say</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-7">Real Results For Arkansas Families</h2>
          <div class="flex flex-col gap-5">
            <div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
              <div class="flex gap-1 mb-3">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="font-body text-grey text-sm leading-relaxed italic mb-4">"Just wanted to let you know it was a great pleasure doing business with you. You made everything so easy for us. I will definitely let anyone who may be looking to sell know about you."</p>
              <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider">Allen C. &ndash; Arkansas Homeowner</p>
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
              <div class="flex gap-1 mb-3">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="font-body text-grey text-sm leading-relaxed italic mb-4">"We were approaching retirement and needed to sell our home in Little Rock, which was well-loved but needed some work. Randy and his team were the perfect partners for us. They were professional, courteous, and fair. The process was easy and stress-free."</p>
              <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider">Jaime M. &ndash; Little Rock, Arkansas</p>
            </div>
          </div>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- FAQ -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Common Questions</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-7">Frequently Asked Questions</h2>
          <div class="flex flex-col gap-3">
            <details class="bg-gray-50 border border-gray-100 rounded-xl overflow-hidden group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
                <span class="font-sub font-bold text-navy text-sm">How quickly can I sell my house in {city.name}?</span>
