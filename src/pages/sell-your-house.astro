---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

const situations = [
  'Are you in foreclosure or about to be?',
  'Do you own unwanted rental property?',
  "Do you have frustrating tenants (or family members) you can't get rid of?",
  'Do you own a vacant property?',
  'Did you inherit an unwanted property?',
  'Do you need to relocate quickly and need to sell your current house fast?',
  'Do you want to avoid paying realtor commissions?',
  'Are you going through a divorce?',
  'Do you have little or no equity and need to sell?',
  "Do you own a \"fixer upper\" that you don't want to fix up or don't have time to fix up?",
];
---

<Layout
  title="Sell Your House Fast In Arkansas | Arkansas Property Buyers"
  description="We buy properties in any condition. Find out if your Arkansas property qualifies for an all-cash offer — no repairs, no fees, no obligation."
>

<!-- HEADER -->
<Header />

<!-- SOFTEN URGENCY BANNER -->
<div class="bg-navy text-white px-5 py-2.5 text-center">
  <p class="font-sub font-bold text-xs uppercase tracking-wider">
    Family-owned &middot; Arkansas-based &middot; 30+ years serving homeowners &ndash;
    <a href="tel:+15015047109" class="text-orange hover:text-gold transition-colors ml-1 underline underline-offset-2">(501) 504-7109</a>
  </p>
</div>

<!-- MAIN CONTENT: 2-column sticky layout -->
<div class="bg-white">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-14 sm:py-20">
    <div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-14 items-start">

      <!-- ═══ LEFT COLUMN: all scrollable content ═══ -->
      <div>

        <!-- HERO CONTENT -->
        <div class="mb-12">
          <p class="eyebrow tracking-widest mb-4">Sell Your House Fast In Arkansas</p>
          <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-4">We Buy Properties In Any Condition</h1>
          <p class="tagline-script mb-5">See how&hellip;</p>
          <p class="font-body text-grey text-base leading-relaxed mb-6 max-w-lg">Find out below if your Arkansas property qualifies for us to make you an all-cash offer.</p>

          <a href="#lead-form" class="lg:hidden inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider w-full sm:w-auto">
            Get My Cash Offer &darr;
          </a>
        </div>

        <hr class="border-gray-100 mb-12">

        <!-- SITUATIONS -->
        <div class="mb-12">
          <p class="eyebrow tracking-widest mb-3">Does This Sound Like You?</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-6">Are You Currently Facing Any Of These Situations?</h2>

          <div class="flex flex-col gap-3">
            {situations.map((item) => (
              <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
                <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <p class="font-body text-grey text-sm">{item}</p>
              </div>
            ))}
          </div>

          <p class="font-body text-grey text-base leading-relaxed mt-8">If you answered "yes" to one or more of these questions, we can help! We are specialists in solving real estate problems&hellip; especially ones that pose a financial burden on you, the homeowner. We can solve almost any financial problem that your property is causing.</p>
          <p class="font-body text-grey text-base leading-relaxed mt-4">We want to help you take control of your situation, end the hassles, and get back to living the life you want to live. And you deserve to know all of the options available to you right now. Simply fill out the short form below or give us a call, and our experts will help you (with no pushy sales techniques or obligation)&hellip; we'll help you make sense of all of this confusion and we'll present you with the options that can potentially change your life and help you get back to normal.</p>
          <p class="font-body text-grey text-base leading-relaxed mt-4">Send us information in the form below and we'll get back to you promptly (usually within 24 hours) &ndash; we'll give you a call and show you the options to help solve your current situation.</p>

          <div class="mt-8 p-5 bg-navy rounded-xl text-center">
            <p class="font-sub font-bold text-white text-sm">100% Free. 100% No Hassle. 100% No Obligation. No Commitment.</p>
          </div>
        </div>

      </div>
      <!-- ═══ END LEFT COLUMN ═══ -->

      <!-- ═══ RIGHT COLUMN: sticky form ═══ -->
      <div id="lead-form" class="lg:sticky lg:top-24">

        <LeadForm
          source="sell-your-house"
          leadType="General Seller"
        />

        <!-- SIDEBAR WIDGET: Listing vs Selling to Us -->
        <div class="mt-4 bg-gray-50 border border-gray-100 rounded-xl px-5 py-5">
          <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-3">Listing vs. Selling To Us</h3>
          <ul class="flex flex-col gap-2 mb-4">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm">Which route is quicker?</p>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm">Puts more cash in your pocket?</p>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm">Has less hassle?</p>
            </li>
          </ul>
          <a href="/compare/" class="inline-flex items-center justify-center gap-2 w-full bg-navy hover:bg-orange text-white font-sub font-bold text-xs px-5 py-3 rounded transition-colors uppercase tracking-wider">
            See The Difference Here &rarr;
          </a>
        </div>

        <div class="mt-4 grid grid-cols-3 gap-2 text-center">
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">No Obligation</p>
          </div>
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">Confidential</p>
          </div>
          <div class="bg-gray-50 border border-gray-100 rounded-lg px-2 py-3">
            <svg class="w-5 h-5 text-navy mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <p class="font-sub font-bold text-navy text-xs leading-tight">Local Arkansas</p>
          </div>
        </div>

      </div>
      <!-- ═══ END RIGHT COLUMN ═══ -->

    </div>
  </div>
</div>

<Footer />

<!-- Mobile sticky CTA bar -->
<div class="apb-sticky-bar lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 px-4 py-3 flex gap-3">
  <a href="#lead-form" class="flex-1 text-center bg-orange hover:bg-gold text-white font-sub font-bold text-xs py-3 rounded transition-colors uppercase tracking-wider">Get My Offer</a>
  <a href="tel:+15015047109" class="flex-1 text-center bg-navy hover:bg-orange text-white font-sub font-bold text-xs py-3 rounded transition-colors uppercase tracking-wider">Call Now</a>
</div>

</Layout>
