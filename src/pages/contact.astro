---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Contact Us | Arkansas Property Buyers"
  description="Reach out to Arkansas Property Buyers. Call (501) 504-7109 or send us a message. No pressure, no obligation — just a straightforward conversation about your situation."
>

<!-- HEADER -->
<Header />

<!-- PAGE HERO -->
<section class="bg-white border-b border-gray-100 pt-14 pb-12 sm:pt-18 sm:pb-16">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 text-center">
    <p class="eyebrow tracking-widest mb-3">Family-Owned &amp; Serving Arkansas for Over 30 Years</p>
    <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-4">Get In Touch</h1>
    <p class="tagline-script mb-5">We love talking with people to see how we can help.</p>
    <p class="font-body text-grey text-base leading-relaxed max-w-xl mx-auto">Whether you have questions about our process, want to learn about your options, or just want to make sure we're real people – we'd love to hear from you. Give us a call or send us a message below and we'll get back to you within 24 hours.</p>
  </div>
</section>

<!-- CONTACT FORM + INFO -->
<section class="bg-white py-14 sm:py-20">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-[1fr_360px] gap-12 lg:gap-14 items-start">

      <!-- FORM -->
      <div>
        <p class="eyebrow tracking-widest mb-3">Send Us a Message</p>
        <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-7">We'll Respond Within 24 Hours</h2>

        <!-- GoHighLevel: In GHL go to Automations → New Workflow → Webhook trigger.
             Copy the webhook URL and paste it into the action attribute below. -->
        <form id="lead-capture-form" action="https://services.leadconnectorhq.com/hooks/kqj3LlvP9g5EoyEpo1w2/webhook-trigger/9c49cd24-d60e-411d-b111-acb479a9cb80" method="POST" class="flex flex-col gap-5">
          <input type="hidden" name="source" value="contact">
          <input type="hidden" name="lead_source" value="Organic Website">
          <input type="hidden" name="lead_type" value="General Seller">
          <input type="hidden" name="pipeline_category" value="Seller Lead">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="c-name" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Your Name</label>
              <input id="c-name" type="text" name="firstName" placeholder="First &amp; Last Name" required class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
            </div>
            <div>
              <label for="c-phone" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Phone Number</label>
              <input id="c-phone" type="tel" name="phone" placeholder="(501) 000-0000" required class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
            </div>
          </div>
          <div>
            <label for="c-email" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Email Address</label>
            <input id="c-email" type="email" name="email" placeholder="you@example.com" required class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
          </div>
          <div>
            <label for="c-message" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Your Message</label>
            <textarea id="c-message" name="message" rows="5" placeholder="Tell us about your situation or ask us anything..." required class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400 resize-none"></textarea>
          </div>
          <div class="flex flex-col gap-2.5">
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" id="cb-sms-transactional" class="mt-0.5 w-4 h-4 flex-shrink-0 rounded border-gray-300 text-orange focus:ring-orange focus:ring-offset-0">
              <span class="font-body text-grey text-[11px] leading-snug">I agree to receive text messages from Arkansas Property Buyers LLC regarding my property inquiry, requested information, appointment scheduling, and related follow-up. Message frequency varies. Message and data rates may apply. Reply STOP to opt out or HELP for help.</span>
            </label>
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" id="cb-sms-marketing" class="mt-0.5 w-4 h-4 flex-shrink-0 rounded border-gray-300 text-orange focus:ring-orange focus:ring-offset-0">
              <span class="font-body text-grey text-[11px] leading-snug">I agree to receive occasional promotional and educational text messages from Arkansas Property Buyers LLC about property-selling options, homeowner resources, and related services. Message frequency varies. Message and data rates may apply. Reply STOP to opt out or HELP for help.</span>
            </label>
            <input type="hidden" id="sms-transactional-consent" name="sms_transactional_consent" value="false">
            <input type="hidden" id="sms-marketing-consent" name="sms_marketing_consent" value="false">
            <p class="font-body text-grey text-[11px] leading-snug">By submitting this form, you agree to our <a href="/terms-and-conditions/" class="text-orange hover:text-gold underline">Terms and Conditions</a> and acknowledge our <a href="/privacy-policy/" class="text-orange hover:text-gold underline">Privacy Policy</a>.</p>
          </div>
          <button type="submit" class="bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-8 py-3.5 rounded transition-colors uppercase tracking-wider w-full sm:w-auto">
            Send Message &rarr;
          </button>
          <p class="font-body text-xs text-grey">We typically respond within 24 hours. For a faster response, give us a call directly at <a href="tel:+15015047109" class="text-orange hover:text-gold transition-colors">(501) 504-7109</a>.</p>
        </form>
      </div>

      <!-- CONTACT INFO -->
      <div class="lg:sticky lg:top-24 flex flex-col gap-5">

        <div class="bg-navy rounded-xl px-6 py-7">
          <h3 class="font-display font-bold text-white uppercase text-lg tracking-wide mb-5">Contact Information</h3>
          <div class="flex flex-col gap-5">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-orange rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              </div>
              <div>
                <p class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-1">Phone</p>
                <a href="tel:+15015047109" class="font-body text-orange hover:text-gold transition-colors text-base font-bold">(501) 504-7109</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-orange rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-1">Office Address</p>
                <p class="font-body text-white/70 text-sm leading-relaxed">Arkansas Property Buyers LLC<br>2024 Arkansas Valley Dr., Ste 407<br>Little Rock, Arkansas 72212</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-orange rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-1">Service Area</p>
                <p class="font-body text-white/70 text-sm leading-relaxed">Serving homeowners across all of Arkansas</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 border border-gray-100 rounded-xl px-6 py-5">
          <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-2">Prefer to talk first?</p>
          <p class="font-body text-grey text-sm leading-relaxed mb-4">We're able to answer calls more quickly than we can return messages. If your situation is time-sensitive, give us a call directly.</p>
          <a href="tel:+15015047109" class="inline-flex items-center justify-center gap-2 bg-navy hover:bg-orange text-white font-sub font-bold text-sm px-5 py-3 rounded transition-colors uppercase tracking-wider w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Call (501) 504-7109
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- FAQ SECTION -->
<section class="bg-gray-50 border-t border-gray-100 py-14 sm:py-20">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-10">
      <p class="eyebrow tracking-widest mb-3">Common Questions</p>
      <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight">Frequently Asked Questions</h2>
    </div>

    <div class="flex flex-col gap-3">
      <details class="bg-white border border-gray-100 rounded-xl overflow-hidden group">
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
          <span class="font-sub font-bold text-navy text-sm">Do you pay fair prices for properties?</span>
          <svg class="w-4 h-4 text-orange flex-shrink-0 ml-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 border-t border-gray-100 pt-4">
          <p class="font-body text-grey text-sm leading-relaxed">In our experience, many sellers aren't necessarily expecting a large "windfall" on the property, but rather appreciate that we can offer cash, we close very quickly (no waiting for financing), and no time or effort or expense is required on your part to fix up the property or pay agent fees. If that's what you're looking for and you see the value in getting your house sold fast&hellip; let's see if we can come to a fair win-win price.</p>
        </div>
      </details>

      <details class="bg-white border border-gray-100 rounded-xl overflow-hidden group">
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
          <span class="font-sub font-bold text-navy text-sm">Are there any fees or commissions to work with you?</span>
          <svg class="w-4 h-4 text-orange flex-shrink-0 ml-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 border-t border-gray-100 pt-4">
          <p class="font-body text-grey text-sm leading-relaxed">This is what makes us stand out from the traditional method of selling your house: There are NO fees or commissions when you sell your house to us. We'll make you an offer, and if it's a fit then we'll buy your house (and we'll often pay for the closing costs too!). No hassle. No fees.</p>
        </div>
      </details>

      <details class="bg-white border border-gray-100 rounded-xl overflow-hidden group">
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
          <span class="font-sub font-bold text-navy text-sm">Is there any obligation when I submit my info?</span>
          <svg class="w-4 h-4 text-orange flex-shrink-0 ml-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 border-t border-gray-100 pt-4">
          <p class="font-body text-grey text-sm leading-relaxed">There is absolutely zero obligation for you. Once you tell us a bit about your property, we'll take a look at things, maybe set up a call with you to find out a bit more, and make you an all-cash offer that's fair for you and fair for us. From there, it's 100% your decision on whether or not you'd like to sell your house to us.</p>
        </div>
      </details>
    </div>
  </div>
</section>

<!-- LATEST BLOG POSTS -->
<section class="bg-white border-t border-gray-100 py-14 sm:py-20">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-10">
      <p class="eyebrow tracking-widest mb-3">Resources &amp; Insights</p>
      <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight">Our Latest Blog Posts</h2>
      <p class="font-body text-grey text-sm mt-3">Helpful articles for Arkansas homeowners navigating real estate decisions.</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="lift group block border border-gray-100 rounded-xl overflow-hidden hover:border-orange transition-colors">
          {post.data.featuredImage ? (
            <div class="aspect-[16/9] overflow-hidden bg-gray-100">
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="aspect-[16/9] bg-gray-100 flex items-center justify-center">
              <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/></svg>
            </div>
          )}
          <div class="p-5">
            <p class="eyebrow tracking-wider mb-2">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h3 class="font-sub font-bold text-navy text-sm leading-snug mb-2 group-hover:text-orange transition-colors">{post.data.title}</h3>
            {post.data.description && (
              <p class="font-body text-grey text-xs leading-relaxed line-clamp-3">{post.data.description}</p>
            )}
            <p class="eyebrow tracking-wider mt-4">Read More &rarr;</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<Footer />

</Layout>

<script is:inline>
document.getElementById('lead-capture-form').addEventListener('submit', function (e) {
  e.preventDefault();
  const form = e.target;
  document.getElementById('sms-transactional-consent').value = document.getElementById('cb-sms-transactional').checked ? 'true' : 'false';
  document.getElementById('sms-marketing-consent').value = document.getElementById('cb-sms-marketing').checked ? 'true' : 'false';
  fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' })
    .finally(() => { window.location.href = '/thank-you/contact/'; });
});
</script>
