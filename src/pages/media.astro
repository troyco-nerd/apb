---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Press & Media | Arkansas Property Buyers"
  description="Arkansas Property Buyers is available for interviews and expert commentary on the Little Rock and Central Arkansas housing market, cash home sales, foreclosure, probate, inherited property, complex title issues, and difficult real estate situations."
>

<Header />

<!-- COMPACT MEDIA HERO -->
<section class="bg-navy py-8 sm:py-10">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow tracking-widest mb-2">Press &amp; Media</p>
        <h1 class="font-display font-bold text-white uppercase leading-tight text-3xl sm:text-4xl mb-3">Local Real Estate Sources For Arkansas Stories</h1>
        <p class="font-body text-white/70 text-sm sm:text-base leading-relaxed">Arkansas Property Buyers is available for interviews, background conversations, and expert commentary on the Little Rock and Central Arkansas housing market.</p>
      </div>
      <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-2 flex-shrink-0">
        <a href="tel:+15015047109" class="inline-flex items-center justify-center bg-orange hover:bg-gold text-white font-sub font-bold text-xs sm:text-sm px-5 py-3 rounded transition-colors uppercase tracking-wider">
          Call (501) 504-7109
        </a>
        <a href="/contact-us" class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 border border-white/20 text-white font-sub font-bold text-xs sm:text-sm px-5 py-3 rounded transition-colors uppercase tracking-wider">
          Media Inquiry &rarr;
        </a>
      </div>
    </div>

    <nav aria-label="Media page sections" class="mt-6 pt-5 border-t border-white/10">
      <div class="flex flex-wrap gap-2">
        <a href="#sources" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Sources</a>
        <a href="#topics" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Topics</a>
        <a href="#story-ideas" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Story Ideas</a>
        <a href="#company" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Company Facts</a>
        <a href="#assets" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Press Assets</a>
        <a href="#contact" class="font-sub font-bold text-[11px] uppercase tracking-wider text-white/75 hover:text-white border border-white/15 hover:border-white/30 rounded-full px-3 py-1.5 transition-colors">Contact</a>
      </div>
    </nav>
  </div>
</section>

<!-- SPOKESPEOPLE -->
<section id="sources" class="bg-white py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-7">
      <div>
        <p class="eyebrow tracking-widest mb-2">Available For Interviews</p>
        <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight">Meet Our Media Sources</h2>
      </div>
      <p class="font-body text-grey text-sm max-w-md">Direct access to people working with Arkansas homeowners and properties every day.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <article class="border border-gray-100 rounded-2xl p-5 sm:p-6 flex gap-5 items-start">
        <img src="/images/randy-thomason.jpg" alt="Randy Thomason, Founder and Principal of Arkansas Property Buyers" class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover flex-shrink-0">
        <div>
          <p class="eyebrow tracking-wider mb-1">Founder &amp; Principal</p>
          <h3 class="font-display font-bold text-navy uppercase text-xl mb-2">Randy Thomason</h3>
          <p class="font-body text-grey text-sm leading-relaxed mb-3">30+ years of entrepreneurial experience in Arkansas, including real estate, business ownership, and community involvement.</p>
          <p class="font-sub font-bold text-navy text-xs uppercase tracking-wide">Best for: market changes, homeowner decisions, difficult sales, title and estate situations.</p>
        </div>
      </article>

      <article class="border border-gray-100 rounded-2xl p-5 sm:p-6 flex gap-5 items-start">
        <img src="/images/anthony-thomason.jpg" alt="Anthony Thomason, Partner at Arkansas Property Buyers" class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover flex-shrink-0">
        <div>
          <p class="eyebrow tracking-wider mb-1">Partner</p>
          <h3 class="font-display font-bold text-navy uppercase text-xl mb-2">Anthony Thomason</h3>
          <p class="font-body text-grey text-sm leading-relaxed mb-3">Hands-on contracting, property evaluation, and day-to-day real estate experience across Central Arkansas.</p>
          <p class="font-sub font-bold text-navy text-xs uppercase tracking-wide">Best for: property condition, repairs, as-is sales, cash offers, and complicated properties.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- QUICK CREDENTIAL STRIP -->
<section class="bg-gray-50 border-y border-gray-100 py-7">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid sm:grid-cols-3 gap-5">
      <div>
        <p class="font-display font-bold text-navy uppercase text-lg">Little Rock Based</p>
        <p class="font-body text-grey text-sm mt-1">Local perspective from Central Arkansas.</p>
      </div>
      <div>
        <p class="font-display font-bold text-navy uppercase text-lg">30+ Years</p>
        <p class="font-body text-grey text-sm mt-1">Experience serving Arkansas homeowners.</p>
      </div>
      <div>
        <p class="font-display font-bold text-navy uppercase text-lg">Real-World Insight</p>
        <p class="font-body text-grey text-sm mt-1">Commentary grounded in actual seller and property situations.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMENTARY TOPICS -->
<section id="topics" class="bg-white py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="mb-7">
      <p class="eyebrow tracking-widest mb-2">Areas Of Commentary</p>
      <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight">Topics We Can Help Explain</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {[
        ['Little Rock Housing Market', 'What local sellers are experiencing and how conditions affect their options.'],
        ['Cash & As-Is Sales', 'How direct sales work and how they compare with traditional listings.'],
        ['Foreclosure & Distress', 'What homeowners face when payments fall behind and timing becomes critical.'],
        ['Probate & Inherited Homes', 'The property challenges families encounter while settling an estate.'],
        ['Complex Title Problems', 'Liens, heirs, ownership questions, and other title complications.'],
        ['Major Repairs', 'What happens when a house needs work that makes a traditional sale difficult.'],
        ['Rental Property Challenges', 'Issues facing landlords with unwanted or difficult properties.'],
        ['Senior Transitions', 'Real estate decisions families face when an older homeowner needs to move.'],
      ].map(([heading, copy]) => (
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-4">
          <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wide mb-2">{heading}</h3>
          <p class="font-body text-grey text-xs sm:text-sm leading-relaxed">{copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- STORY IDEAS -->
<section id="story-ideas" class="bg-navy py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-[.7fr_1.3fr] gap-7 lg:gap-12">
      <div>
        <p class="eyebrow tracking-widest mb-2">Need An Angle?</p>
        <h2 class="font-display font-bold text-white uppercase text-2xl sm:text-3xl leading-tight mb-3">Story Ideas We Can Help Develop</h2>
        <p class="font-body text-white/60 text-sm leading-relaxed">Starting points for reporters covering housing, homeowners, estates, or difficult property situations in Arkansas.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-2.5">
        {[
          'What Little Rock homeowners should know before accepting a cash offer',
          'When selling a house as-is makes sense — and when it does not',
          'Why inherited homes get complicated when heirs or title issues are involved',
          'What homeowners facing foreclosure should understand before time runs short',
          'Why major repairs can change the economics of a traditional home sale',
          'The property decisions families face when a parent moves into senior living',
          'What local cash buyers see that may not show up in MLS data',
          'When an unwanted rental property is no longer worth keeping',
        ].map((idea) => (
          <div class="flex items-start gap-2.5 border border-white/10 bg-white/5 rounded-lg px-3.5 py-3">
            <svg class="w-3.5 h-3.5 text-orange flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <p class="font-body text-white/80 text-sm leading-relaxed">{idea}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- COMPANY FACTS + BOILERPLATE -->
<section id="company" class="bg-white py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-5">
      <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6">
        <p class="eyebrow tracking-widest mb-2">Company At A Glance</p>
        <h2 class="font-display font-bold text-navy uppercase text-2xl mb-5">Arkansas Property Buyers</h2>
        <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-4">
          <div>
            <dt class="font-sub font-bold text-navy text-xs uppercase tracking-wide mb-1">Based In</dt>
            <dd class="font-body text-grey text-sm">Little Rock, Arkansas</dd>
          </div>
          <div>
            <dt class="font-sub font-bold text-navy text-xs uppercase tracking-wide mb-1">Business</dt>
            <dd class="font-body text-grey text-sm">Family-owned direct home buyer</dd>
          </div>
          <div>
            <dt class="font-sub font-bold text-navy text-xs uppercase tracking-wide mb-1">Experience</dt>
            <dd class="font-body text-grey text-sm">30+ years</dd>
          </div>
          <div>
            <dt class="font-sub font-bold text-navy text-xs uppercase tracking-wide mb-1">Service Area</dt>
            <dd class="font-body text-grey text-sm">Central Arkansas &amp; surrounding communities</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="font-sub font-bold text-navy text-xs uppercase tracking-wide mb-1">Office</dt>
            <dd class="font-body text-grey text-sm">2024 Arkansas Valley Dr., Ste 407, Little Rock, AR 72212</dd>
          </div>
        </dl>
      </div>

      <div class="border border-gray-100 rounded-2xl p-6">
        <p class="eyebrow tracking-widest mb-2">Company Boilerplate</p>
        <h2 class="font-display font-bold text-navy uppercase text-2xl mb-4">For Publication</h2>
        <p class="font-body text-grey text-sm leading-relaxed mb-4">Arkansas Property Buyers is a family-owned home buying company based in Little Rock, Arkansas. The company helps homeowners sell houses directly and as-is, without repairs, clean-outs, showings, or agent commissions. Its team works with property owners navigating foreclosure, probate, inherited homes, major repairs, unwanted rentals, title complications, senior transitions, and other difficult real estate situations throughout Central Arkansas and surrounding communities.</p>
        <p class="font-body text-grey text-xs leading-relaxed italic">Reporters and editors are welcome to use or adapt this description.</p>
      </div>
    </div>
  </div>
</section>

<!-- PRESS ASSETS -->
<section id="assets" class="bg-gray-50 border-y border-gray-100 py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-7">
      <div>
        <p class="eyebrow tracking-widest mb-2">Press Assets</p>
        <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight">Photos &amp; Brand Materials</h2>
      </div>
      <p class="font-body text-grey text-sm">For editorial coverage of Arkansas Property Buyers.</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <a href="/images/Arkansas%20Property%20Buyers.png" target="_blank" class="group bg-white border border-gray-100 rounded-xl p-3 sm:p-4 hover:border-orange/40 hover:shadow-sm transition-all">
        <div class="h-24 flex items-center justify-center bg-gray-50 rounded-lg mb-3 p-3">
          <img src="/images/Arkansas%20Property%20Buyers.png" alt="Arkansas Property Buyers logo" class="max-h-full max-w-full object-contain">
        </div>
        <p class="font-sub font-bold text-navy text-xs sm:text-sm group-hover:text-orange transition-colors">Company Logo</p>
      </a>

      <a href="/images/apbteam.png" target="_blank" class="group bg-white border border-gray-100 rounded-xl p-3 sm:p-4 hover:border-orange/40 hover:shadow-sm transition-all">
        <div class="h-24 overflow-hidden bg-gray-50 rounded-lg mb-3">
          <img src="/images/apbteam.png" alt="Arkansas Property Buyers team" class="w-full h-full object-cover">
        </div>
        <p class="font-sub font-bold text-navy text-xs sm:text-sm group-hover:text-orange transition-colors">Team Photo</p>
      </a>

      <a href="/images/randy-thomason.jpg" target="_blank" class="group bg-white border border-gray-100 rounded-xl p-3 sm:p-4 hover:border-orange/40 hover:shadow-sm transition-all">
        <div class="h-24 overflow-hidden bg-gray-50 rounded-lg mb-3">
          <img src="/images/randy-thomason.jpg" alt="Randy Thomason headshot" class="w-full h-full object-cover object-top">
        </div>
        <p class="font-sub font-bold text-navy text-xs sm:text-sm group-hover:text-orange transition-colors">Randy Thomason</p>
      </a>

      <a href="/images/anthony-thomason.jpg" target="_blank" class="group bg-white border border-gray-100 rounded-xl p-3 sm:p-4 hover:border-orange/40 hover:shadow-sm transition-all">
        <div class="h-24 overflow-hidden bg-gray-50 rounded-lg mb-3">
          <img src="/images/anthony-thomason.jpg" alt="Anthony Thomason headshot" class="w-full h-full object-cover object-top">
        </div>
        <p class="font-sub font-bold text-navy text-xs sm:text-sm group-hover:text-orange transition-colors">Anthony Thomason</p>
      </a>
    </div>
  </div>
</section>

<!-- DEADLINE CTA -->
<section id="contact" class="bg-white py-10 sm:py-14 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="bg-navy rounded-2xl p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
      <div>
        <p class="eyebrow tracking-widest mb-2">On Deadline?</p>
        <h2 class="font-display font-bold text-white uppercase text-2xl sm:text-3xl leading-tight mb-2">Need A Local Real Estate Source?</h2>
        <p class="font-body text-white/65 text-sm leading-relaxed max-w-xl">Tell us what you are working on. We will do our best to respond quickly and connect you with the right person.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-2 flex-shrink-0">
        <a href="tel:+15015047109" class="inline-flex items-center justify-center bg-orange hover:bg-gold text-white font-sub font-bold text-xs sm:text-sm px-5 py-3 rounded transition-colors uppercase tracking-wider">Call (501) 504-7109</a>
        <a href="/contact-us" class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 border border-white/20 text-white font-sub font-bold text-xs sm:text-sm px-5 py-3 rounded transition-colors uppercase tracking-wider">Contact The Team</a>
      </div>
    </div>
  </div>
</section>

<Footer />

</Layout>
