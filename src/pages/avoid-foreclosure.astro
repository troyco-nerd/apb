---
import Layout from '../layouts/Layout.astro';
---

<Layout>

<!-- HEADER -->
<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/apb icon.png" alt="Arkansas Property Buyers" class="h-10 w-auto object-contain">
        <span class="font-sub font-bold text-navy text-sm tracking-tight">Arkansas Property Buyers</span>
      </a>
      <nav class="hidden md:flex items-center gap-7">
        <a href="/#how-it-works" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">How It Works</a>
        <a href="/#about"        class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">About Us</a>
        <a href="/#testimonials" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Reviews</a>
        <a href="tel:+15015551234" class="font-sub font-bold text-sm text-orange flex items-center gap-1.5 hover:text-gold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (501) 555-1234
        </a>
        <a href="#lead-form" class="bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-4 py-2 rounded transition-colors uppercase tracking-wider">Get My Offer</a>
      </nav>
      <button onclick="document.getElementById('mobNav').classList.toggle('open')" class="md:hidden p-2 text-grey">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobNav" class="mob-nav md:hidden border-t border-gray-100">
      <nav class="flex flex-col py-4 gap-1">
        <a href="/#how-it-works" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">How It Works</a>
        <a href="/#about"        class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">About Us</a>
        <a href="/#testimonials" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Reviews</a>
        <a href="tel:+15015551234" class="py-2 px-1 font-sub font-bold text-sm text-orange">(501) 555-1234</a>
        <a href="#lead-form" class="mt-2 bg-orange text-white font-sub font-bold text-xs px-4 py-2.5 rounded text-center uppercase tracking-wider">Get My Offer</a>
      </nav>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="bg-white pt-16 pb-20 sm:pt-20 sm:pb-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-[1fr_420px] gap-12 lg:gap-16 items-start">

      <!-- Left: content -->
      <div class="pt-1 lg:pt-4">
        <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-4">Little Rock, Arkansas</p>
        <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-3">We Buy Properties<br>In Any Condition</h1>
        <p class="font-script text-orange text-xl mb-6">Find out if your property qualifies.</p>
        <p class="font-body text-grey text-base leading-relaxed mb-8 max-w-md">Find out below if your Little Rock property qualifies for us to make you an all-cash offer. No repairs, no commissions, no hassle — just a fair offer and a fast close.</p>

        <div class="flex flex-col gap-5 mb-10">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-sub font-bold text-navy text-sm">Close Before Your Auction Date</p>
              <p class="font-body text-grey text-sm">We move fast — sometimes in as few as 7 days.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-sub font-bold text-navy text-sm">Zero Fees or Commissions</p>
              <p class="font-body text-grey text-sm">What we offer is what you keep.</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-navy flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <div>
              <p class="font-sub font-bold text-navy text-sm">No Repairs or Cleanout Required</p>
              <p class="font-body text-grey text-sm">Sell your property exactly as it sits.</p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 text-sm text-grey font-body border-t border-gray-100 pt-6">
          <svg class="w-4 h-4 text-navy flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Serving Little Rock and all of Arkansas</span>
        </div>
      </div>

      <!-- Right: 2-step lead capture form -->
      <div id="lead-form" class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
        <div class="bg-navy px-6 py-5">
          <h2 class="font-display font-bold text-white uppercase text-lg tracking-wide">Get Your Fair Cash Offer</h2>
          <p class="font-body text-white/60 text-sm mt-1">Fill out the short form below — it takes less than a minute.</p>
        </div>

        <!-- Step indicator -->
        <div class="px-6 pt-5 pb-2 flex items-center gap-2">
          <div id="dot1" class="step-dot active w-7 h-7 rounded-full border-2 border-orange bg-orange text-white flex items-center justify-center font-sub font-bold text-xs flex-shrink-0">1</div>
          <div id="connector" class="flex-1 h-0.5 bg-gray-200 transition-colors duration-300"></div>
          <div id="dot2" class="step-dot w-7 h-7 rounded-full border-2 border-gray-200 flex items-center justify-center font-sub font-bold text-xs text-grey flex-shrink-0">2</div>
          <span id="step-label" class="font-body text-xs text-grey ml-1 flex-shrink-0">Step 1 of 2</span>
        </div>

        <!-- STEP 1: Name + Phone -->
        <div id="step1" class="px-6 pb-6 pt-3 fade-up">
          <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-4">Tell us who you are</p>
          <div class="flex flex-col gap-4">
            <div>
              <label for="f-name" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Your Name</label>
              <input id="f-name" type="text" placeholder="First &amp; Last Name" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
            </div>
            <div>
              <label for="f-phone" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Phone Number</label>
              <input id="f-phone" type="tel" placeholder="(501) 000-0000" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
            </div>
            <button type="button" onclick="goToStep2()" class="w-full bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider mt-1">
              Next: Property Address &rarr;
            </button>
          </div>
          <p class="font-body text-xs text-grey text-center mt-4">100% free &middot; no obligation &middot; no commitment</p>
        </div>

        <!-- STEP 2: Property Address -->
        <!-- Salesforce Web-to-Lead: update action URL, oid value, and retURL before going live -->
        <div id="step2" class="px-6 pb-6 pt-3 hidden">
          <p class="font-sub font-bold text-navy text-xs uppercase tracking-wider mb-4">Tell us about the property</p>
          <form id="lead-capture-form" action="#" method="POST">
            <input type="hidden" name="oid" value="YOUR_SALESFORCE_OID">
            <input type="hidden" name="retURL" value="/thank-you">
            <input type="hidden" id="sf-name" name="first_name" value="">
            <input type="hidden" id="sf-phone" name="phone" value="">
            <div class="flex flex-col gap-4">
              <div>
                <label for="f-street" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Street Address</label>
                <input id="f-street" type="text" name="street" placeholder="123 Main St" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="f-city" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">City</label>
                  <input id="f-city" type="text" name="city" placeholder="Little Rock" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
                </div>
                <div>
                  <label for="f-zip" class="block font-sub font-bold text-navy text-xs uppercase tracking-wider mb-1.5">Zip Code</label>
                  <input id="f-zip" type="text" name="zip" placeholder="72201" class="field w-full border border-gray-200 rounded-lg px-4 py-3 font-body text-sm text-navy placeholder-gray-400">
                </div>
              </div>
              <div class="flex gap-2 mt-1">
                <button type="button" onclick="goToStep1()" class="w-1/3 border border-gray-200 text-grey font-sub font-bold text-xs px-4 py-3.5 rounded hover:border-navy hover:text-navy transition-colors">&larr; Back</button>
                <button type="submit" class="flex-1 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider">Get My Cash Offer</button>
              </div>
            </div>
          </form>
          <p class="font-body text-xs text-grey text-center mt-4">We'll call you within 24 hours &middot; no pushy sales</p>
        </div>

        <!-- Phone CTA -->
        <div class="px-6 pb-6 pt-1 border-t border-gray-100">
          <a href="tel:+15015551234" class="inline-flex items-center justify-center gap-2 bg-navy hover:bg-orange text-white font-sub font-bold text-sm px-6 py-3.5 rounded transition-colors uppercase tracking-wider w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Or Call (501) 555-1234
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SITUATIONS -->
<section class="bg-gray-50 py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">See How We Can Help</p>
        <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight">Are You Currently Facing<br>Any of These Situations?</h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mb-10">
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Are You In Foreclosure or Are About To Be?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Own Unwanted Rental Property?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Have Frustrating Tenants (Or Family Members) That You Can't Get Rid Of?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Own A Vacant Property?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Did You Inherit An Unwanted Property?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Need To Relocate Quickly And Need To Sell Your Current House Fast?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Want To Avoid Paying Realtor Commissions?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Are You Going Through A Divorce?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Have Little Or No Equity And Need To Sell?</p>
        </div>
        <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-lg p-4 lift">
          <svg class="w-5 h-5 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <p class="font-body text-grey text-sm leading-relaxed">Do You Own A "Fixer Upper" That You Don't Want To Fix Up Or Don't Have Time To Fix Up?</p>
        </div>
      </div>

      <!-- Body copy -->
      <div class="bg-white border border-gray-100 rounded-xl p-8">
        <p class="font-sub font-bold text-navy text-base mb-4">If you answered "yes" to one or more of these questions, we can help!</p>
        <p class="font-body text-grey text-sm leading-relaxed mb-4">We are specialists in solving real estate problems… especially ones that pose a financial burden on you, the homeowner. We can solve almost any financial problem that your property is causing.</p>
        <p class="font-body text-grey text-sm leading-relaxed mb-4">We want to help you take control of your situation, end the hassles, and get back to living the life you want to live. And you deserve to know all of the options available to you right now. Simply fill out the short form above or give us a call, and our experts will help you (with no pushy sales techniques or obligation)&hellip; we'll help you make sense of all of this confusion and we'll present you with the options that can potentially change your life and help you get back to normal.</p>
        <p class="font-body text-grey text-sm leading-relaxed mb-6">Send us information in the form above and we'll get back to you promptly (usually within 24 hours) — we'll give you a call and show you the options to help solve your current situation.</p>
        <div class="flex flex-wrap gap-x-8 gap-y-3 pt-5 border-t border-gray-100">
          <div class="flex items-center gap-2 font-sub font-bold text-navy text-sm">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            100% Free to You
          </div>
          <div class="flex items-center gap-2 font-sub font-bold text-navy text-sm">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            100% No Hassle
          </div>
          <div class="flex items-center gap-2 font-sub font-bold text-navy text-sm">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            No Obligation
          </div>
          <div class="flex items-center gap-2 font-sub font-bold text-navy text-sm">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            No Commitment
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section id="testimonials" class="bg-white py-20 sm:py-28 border-b border-gray-100">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12">
      <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">Client Stories</p>
      <h2 class="font-display font-bold text-navy uppercase text-3xl sm:text-4xl leading-tight">What Our Clients Say</h2>
      <p class="font-body text-grey mt-3 text-sm">Real experiences from Arkansas homeowners we've helped.</p>
