---
import Layout from '../layouts/Layout.astro';
---

<Layout>

<!-- HEADER -->
<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/apb icon.png" alt="Arkansas Property Buyers" class="h-10 w-auto object-contain">
        <span class="font-sub font-bold text-navy text-sm tracking-tight">Arkansas Property Buyers</span>
      </a>
      <nav class="hidden md:flex items-center gap-7">
        <a href="/#how-it-works" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">How It Works</a>
        <a href="/#about"        class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">About Us</a>
        <a href="/#testimonials" class="font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy transition-colors">Reviews</a>
        <a href="tel:+15015551234" class="font-sub font-bold text-sm text-orange flex items-center gap-1.5 hover:text-gold transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (501) 555-1234
        </a>
        <a href="#lead-form" class="bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-4 py-2 rounded transition-colors uppercase tracking-wider">Get My Offer</a>
      </nav>
      <button onclick="document.getElementById('mobNav').classList.toggle('open')" class="md:hidden p-2 text-grey">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobNav" class="mob-nav md:hidden border-t border-gray-100">
      <nav class="flex flex-col py-4 gap-1">
        <a href="/#how-it-works" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">How It Works</a>
        <a href="/#about"        class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">About Us</a>
        <a href="/#testimonials" class="py-2 px-1 font-sub font-bold text-xs text-grey uppercase tracking-wider hover:text-navy">Reviews</a>
        <a href="tel:+15015551234" class="py-2 px-1 font-sub font-bold text-sm text-orange">(501) 555-1234</a>
        <a href="#lead-form" class="mt-2 bg-orange text-white font-sub font-bold text-xs px-4 py-2.5 rounded text-center uppercase tracking-wider">Get My Offer</a>
      </nav>
    </div>
  </div>
</header>

<!-- URGENCY BANNER -->
<div class="bg-orange text-white px-5 py-2.5 text-center">
  <p class="font-sub font-bold text-xs uppercase tracking-wider">
    <span class="opacity-80 mr-2">&#9888;</span>
    Auction date approaching? We can close in as few as 7 days &mdash;
    <a href="tel:+15015551234" class="underline underline-offset-2 hover:text-white/80 transition-colors ml-1">Call (501) 555-1234 now</a>
  </p>
</div>

<!-- MAIN CONTENT: 2-column sticky layout -->
<div class="bg-white">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-14 sm:py-20">
    <div class="grid lg:grid-cols-[1fr_400px] gap-12 lg:gap-14 items-start">

      <!-- ═══ LEFT COLUMN: all scrollable content ═══ -->
      <div>

        <!-- HEADLINE & OPENER -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-4">Little Rock, Arkansas</p>
          <h1 class="font-display font-bold text-navy uppercase leading-tight text-4xl sm:text-5xl mb-4">Facing Foreclosure?<br>You Still Have Options.</h1>
          <p class="font-script text-orange text-xl mb-5">It's not too late — let us show you the way out.</p>
          <p class="font-body text-grey text-base leading-relaxed mb-6 max-w-lg">We buy properties in any condition across Little Rock and all of Arkansas. Find out if your property qualifies for an all-cash offer — and how we can help you avoid foreclosure before time runs out.</p>

          <!-- Quick trust bar -->
          <div class="flex flex-wrap gap-x-6 gap-y-2 mb-8">
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Close in 7 days
            </div>
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Zero fees or commissions
            </div>
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              No repairs or cleanout
            </div>
            <div class="flex items-center gap-2 font-sub font-bold text-navy text-xs">
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              100% no obligation
            </div>
          </div>

          <!-- Mobile-only: CTA into form -->
          <a href="#lead-form" class="lg:hidden inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-7 py-3.5 rounded transition-colors uppercase tracking-wider w-full sm:w-auto">
            See If My Property Qualifies &darr;
          </a>
        </div>

        <!-- DIVIDER -->
        <hr class="border-gray-100 mb-12">

        <!-- SITUATIONS CHECKLIST -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">See How We Can Help</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-2">Are You Currently Facing<br>Any of These Situations?</h2>
          <p class="font-body text-grey text-sm mb-8">If any of these sound familiar, we can help.</p>

          <div class="flex flex-col gap-3">
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Are You In Foreclosure or Are About To Be?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Own Unwanted Rental Property?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Have Frustrating Tenants (Or Family Members) That You Can't Get Rid Of?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Own A Vacant Property?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Did You Inherit An Unwanted Property?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Need To Relocate Quickly And Need To Sell Your Current House Fast?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Want To Avoid Paying Realtor Commissions?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Are You Going Through A Divorce?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Have Little Or No Equity And Need To Sell?</p>
            </div>
            <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg px-4 py-3.5">
              <svg class="w-4 h-4 text-orange flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <p class="font-body text-grey text-sm leading-snug">Do You Own A "Fixer Upper" That You Don't Want To Fix Up Or Don't Have Time To Fix Up?</p>
            </div>
          </div>

          <!-- Inline CTA after checklist -->
          <div class="mt-8 p-5 bg-navy rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <p class="font-sub font-bold text-white text-sm">If you said yes to any of these &mdash; we can help.</p>
            <a href="#lead-form" class="flex-shrink-0 bg-orange hover:bg-gold text-white font-sub font-bold text-xs px-5 py-2.5 rounded transition-colors uppercase tracking-wider">Fill Out the Form &rarr;</a>
          </div>
        </div>

        <!-- DIVIDER -->
        <hr class="border-gray-100 mb-12">

        <!-- BODY COPY -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">We Solve Real Estate Problems</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-5">We Can Help — Here's How</h2>

          <div class="space-y-4 font-body text-grey text-sm leading-relaxed">
            <p>If you answered "yes" to one or more of those questions, <strong class="text-navy font-bold">we can help.</strong> We are specialists in solving real estate problems&hellip; especially ones that pose a financial burden on you, the homeowner. We can solve almost any financial problem that your property is causing.</p>
            <p>We want to help you take control of your situation, end the hassles, and get back to living the life you want to live. And you deserve to know all of the options available to you right now.</p>
            <p>Simply fill out the short form on this page or give us a call, and our experts will help you (with <strong class="text-navy font-bold">no pushy sales techniques or obligation</strong>)&hellip; we'll help you make sense of all of this confusion and present you with the options that can potentially change your life and help you get back to normal.</p>
            <p>Send us your information and we'll get back to you promptly &mdash; <strong class="text-navy font-bold">usually within 24 hours</strong>. We'll give you a call and walk you through every option available for your situation.</p>
          </div>

          <!-- Guarantee strip -->
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="text-center bg-gray-50 border border-gray-100 rounded-lg p-3">
              <p class="font-display font-bold text-navy text-lg leading-none mb-1">100%</p>
              <p class="font-body text-xs text-grey">Free to You</p>
            </div>
            <div class="text-center bg-gray-50 border border-gray-100 rounded-lg p-3">
              <p class="font-display font-bold text-navy text-lg leading-none mb-1">100%</p>
              <p class="font-body text-xs text-grey">No Hassle</p>
            </div>
            <div class="text-center bg-gray-50 border border-gray-100 rounded-lg p-3">
              <p class="font-display font-bold text-navy text-lg leading-none mb-1">Zero</p>
              <p class="font-body text-xs text-grey">Obligation</p>
            </div>
            <div class="text-center bg-gray-50 border border-gray-100 rounded-lg p-3">
              <p class="font-display font-bold text-navy text-lg leading-none mb-1">Zero</p>
              <p class="font-body text-xs text-grey">Commitment</p>
            </div>
          </div>
        </div>

        <!-- DIVIDER -->
        <hr class="border-gray-100 mb-12">

        <!-- TESTIMONIALS -->
        <div class="mb-12">
          <p class="font-sub font-bold text-xs text-orange uppercase tracking-widest mb-3">What Others Say</p>
          <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight mb-8">Real Arkansas Homeowners. Real Results.</h2>

          <div class="flex flex-col gap-5">
            <div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
              <div class="flex gap-0.5 mb-3">
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <p class="font-body text-grey text-sm leading-relaxed mb-4">"I received a foreclosure notice and panicked. Arkansas Property Buyers called me back within hours, explained my options clearly, and we closed two weeks before my auction date. They literally saved my credit."</p>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-navy rounded-full flex items-center justify-center font-sub font-bold text-white text-xs">TW</div>
                <div>
                  <p class="font-sub font-bold text-navy text-sm">Testimonial Placeholder</p>
                  <p class="font-body text-xs text-grey">Little Rock, AR</p>
                </div>
              </div>
            </div>

            <div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
              <div class="flex gap-0.5 mb-3">
