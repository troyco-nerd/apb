---
import { cities } from '../data/cities.js';
---
<footer class="bg-navy border-t border-white/10 py-12">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">

      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 bg-orange rounded flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <span class="font-sub font-bold text-white text-sm">Arkansas Property Buyers</span>
        </div>
        <p class="font-body text-white/50 text-sm leading-relaxed mb-4">A family-owned Arkansas company helping homeowners navigate life's real estate challenges for over 30 years.</p>
        <a href="https://www.facebook.com/propertybuyersar/" target="_blank" rel="noopener" aria-label="Arkansas Property Buyers on Facebook" class="inline-flex items-center justify-center w-8 h-8 bg-white/10 hover:bg-orange rounded-full transition-colors">
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-4">Quick Links</h4>
        <nav class="flex flex-col gap-2.5 font-body text-sm text-white/50">
          <a href="/"               class="hover:text-white transition-colors">Home</a>
          <a href="/#how-it-works"  class="hover:text-white transition-colors">How It Works</a>
          <a href="/our-company"          class="hover:text-white transition-colors">About Us</a>
          <a href="/compare"        class="hover:text-white transition-colors">Compare Your Options</a>
          <a href="/faq"            class="hover:text-white transition-colors">FAQ</a>
          <a href="/making-the-transition-easier" class="hover:text-white transition-colors">Senior Care Help</a>
          <a href="/blog"           class="hover:text-white transition-colors">Blog</a>
          <a href="/contact-us"        class="hover:text-white transition-colors">Contact Us</a>
        </nav>
      </div>

      <!-- Where We Work -->
      <div>
        <h4 class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-4">Where We Work</h4>
        <nav class="flex flex-col gap-2.5 font-body text-sm text-white/50">
          {cities.map((city) => (
            <a href={`/sell-my-house-fast-${city.slug}-ar/`} class="hover:text-white transition-colors">
              Sell My House Fast In {city.name}, AR
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-sub font-bold text-white text-xs uppercase tracking-wider mb-4">Contact</h4>
        <div class="flex flex-col gap-2.5 font-body text-sm text-white/50">
          <a href="tel:+15015047109" class="text-orange hover:text-gold transition-colors font-bold">(501) 504-7109</a>
          <p>2024 Arkansas Valley Dr., Ste 407</p>
          <p>Little Rock, AR 72212</p>
        </div>
      </div>

    </div>
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center font-body text-xs text-white/30">
      <span>&copy; 2026 Arkansas Property Buyers. All rights reserved.</span>
      <span class="hidden sm:inline">&middot;</span>
      <a href="/terms-and-conditions/" class="hover:text-white/60 transition-colors">Terms and Conditions</a>
      <span class="hidden sm:inline">&middot;</span>
      <a href="/privacy/" class="hover:text-white/60 transition-colors">Privacy Policy</a>
    </div>
  </div>
</footer>
