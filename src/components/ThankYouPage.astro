---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  tagline: string;
  message: string;
  steps: Step[];
  testimonialQuote: string;
  testimonialName: string;
  testimonialLocation: string;
}

const {
  title,
  description,
  eyebrow,
  heading,
  tagline,
  message,
  steps,
  testimonialQuote,
  testimonialName,
  testimonialLocation,
} = Astro.props;
---

<Layout title={title} description={description}>

<!-- HEADER -->
<Header />

<!-- THANK YOU HERO -->
<section class="bg-white py-16 sm:py-24">
  <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center">
    <div class="w-16 h-16 bg-orange/10 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8 text-orange" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
    </div>
    <p class="eyebrow tracking-widest mb-3">{eyebrow}</p>
    <h1 class="font-display font-bold text-navy uppercase leading-tight text-3xl sm:text-4xl mb-4">{heading}</h1>
    <p class="tagline-script mb-5">{tagline}</p>
    <p class="font-body text-grey text-base leading-relaxed max-w-lg mx-auto mb-8">{message}</p>

    <a href="tel:+15015047109" class="inline-flex items-center justify-center gap-2 bg-orange hover:bg-gold text-white font-sub font-bold text-sm px-8 py-3.5 rounded transition-colors uppercase tracking-wider">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
      Or Call Us Now &mdash; (501) 504-7109
    </a>
  </div>
</section>

<!-- WHAT HAPPENS NEXT -->
<section class="bg-gray-50 border-y border-gray-100 py-14 sm:py-16">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <p class="eyebrow tracking-widest text-center mb-3">What Happens Next</p>
    <h2 class="font-display font-bold text-navy uppercase text-2xl sm:text-3xl leading-tight text-center mb-10">Here's What To Expect</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      {steps.map((step, i) => (
        <div class="bg-white border border-gray-100 rounded-xl p-6 text-center">
          <div class="w-9 h-9 bg-navy text-white rounded-full flex items-center justify-center font-sub font-bold text-sm mx-auto mb-4">{i + 1}</div>
          <h3 class="font-sub font-bold text-navy text-sm uppercase tracking-wider mb-2">{step.title}</h3>
          <p class="font-body text-grey text-sm leading-relaxed">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TESTIMONIAL -->
<section class="bg-white py-14 sm:py-16">
  <div class="max-w-xl mx-auto px-5 sm:px-8 text-center">
    <div class="flex gap-0.5 justify-center mb-4">
      {Array.from({ length: 5 }).map(() => (
        <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      ))}
    </div>
    <p class="font-body text-grey text-base leading-relaxed italic mb-4">"{testimonialQuote}"</p>
    <p class="font-sub font-bold text-navy text-sm">&ndash; {testimonialName}, {testimonialLocation}</p>
  </div>
</section>

<Footer />

</Layout>
